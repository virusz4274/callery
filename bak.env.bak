# Fresh deployment template for a single Google Cloud project with Firebase enabled.
# Fill these values from the new production project before first deploy.

# Base app URL used for OAuth callbacks, webhook metadata, and public share links.
NEXT_PUBLIC_APP_URL=https://your-app.example.com

# MongoDB
MONGODB_URI=mongodb://localhost:27017/call-memo
# MONGODB_CONNECTION_MODE=default
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Firebase client config
NEXT_PUBLIC_FIREBASE_API_KEY=replace-me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:replace-me
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-me.apps.googleusercontent.com
# FIREBASE_AUTH_HELPER_ORIGIN=https://your-project.firebaseapp.com

# Firebase Admin
# Choose one:
# 1) Put service-account.json in the repo root for local development
# 2) Set the full JSON string here for container/hosted environments
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Cloudflare R2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=call-memo-recordings
# R2_REGION=auto
# R2_FORCE_PATH_STYLE=false

# Signing secrets
UPLOAD_SESSION_SECRET=replace-with-long-random-secret
SHARE_LINK_SECRET=replace-with-long-random-secret
MOBILE_SYNC_SESSION_SECRET=replace-with-long-random-secret
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-secret
# GOOGLE_TOKEN_ENCRYPTION_KEY_VERSION=v1

# Feature flags
NEXT_PUBLIC_ENABLE_BILLING=false
NEXT_PUBLIC_SHOW_MOBILE_BURGER_MENU=false
# CSP_REPORT_ONLY=false

# Google Contacts OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=https://your-app.example.com/api/auth/google/callback

# First-login bootstrap admin allowlist
ADMIN_BOOTSTRAP_EMAILS=admin@example.com

# Gemini
GOOGLE_GENERATIVE_AI_API_KEY=replace-me
GEMINI_MODEL_SUMMARY=gemini-2.0-flash-lite-preview-02-05
GEMINI_MODEL_TRANSLITERATION=gemini-2.0-flash-lite-preview-02-05

# Soniox
SONIOX_API_BASE_URL=https://api.soniox.com
SONIOX_MODEL_ID=stt-async-v3
# SONIOX_API_KEY=replace-me
# SONIOX_WEBHOOK_SECRET=replace-me

# ElevenLabs
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_ID=scribe_v2
# ELEVENLABS_API_KEY=replace-me
# ELEVENLABS_WEBHOOK_SECRET=replace-me

# Stripe
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Web Push
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-me
# VAPID_PRIVATE_KEY=replace-me
VAPID_CONTACT_EMAIL=admin@example.com

# Email / support
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=replace-me
# SMTP_PASS=replace-me
SMTP_FROM="vosift <no-reply@example.com>"
# SUPPORT_EMAIL=support@example.com

# Cron / export processing
# CRON_SECRET=replace-with-long-random-secret
EXPORT_JOB_STALE_MINUTES=90
EXPORT_INLINE_PROCESSING=false
SOFT_DELETE_RESTORE_DAYS=30
