+// Bound every recursive AST walker, including callers that provide their own AST.
+exports.MAX_DEPTH = 100;
+exports.assertMaxDepth = ast => {
+  const stack = [[ast, 0]];
+  while (stack.length > 0) {
+    const [node, depth] = stack.pop();
+    if (depth > exports.MAX_DEPTH) {
+      throw new SyntaxError(`Input nesting exceeds max depth (${exports.MAX_DEPTH})`);
+    }
+    if (node && Array.isArray(node.nodes)) {
+      for (const child of node.nodes) {
+        if (child && Array.isArray(child.nodes)) {
+          stack.push([child, depth + 1]);
+        }
+      }
+    }
+  }
