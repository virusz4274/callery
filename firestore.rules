
/**
 * This ruleset enforces a strict user-ownership model for the Call Memo app,
 * with a special exception for users with an 'admin' role.
 *
 * Core Philosophy:
 * The security model is built on user data isolation. All user-specific data
 * is stored within a hierarchical structure dedicated to that user. Access is
 * granted based on the authenticated user's UID matching the user ID in the
 * document path. A special 'admin' role grants broader read access for
 * management purposes.
 *
 * Data Structure:
 * All data is nested under the `/users/{userId}` path. A user's contacts and
 * recordings are stored in subcollections under their main user document.
 *
 * Key Security Decisions:
 * - Strict Ownership for Users: All non-admin operations (write, delete) are
 *   restricted to the document owner.
 * - Admin Read Access: Users with the 'admin' role are granted read-only
 *   access to list and get all user profiles.
 * - Path-Based Security: Authorization relies on the `{userId}` wildcard in the
 *   path, which is the most performant and secure way to handle user-owned data.
 * - Relational Integrity: On document creation, rules enforce that the `userId`
 *   (or `id` on the user document) inside the document's data matches the `userId`
 *   from the path. These key identifiers are then enforced as immutable on updates.
 *
 * Denormalization for Authorization:
 * The data model is designed for simple authorization. Placing contacts and
 * recordings in subcollections under a user's document allows us to secure
 * them without needing extra database reads (`get()` calls). The rules simply
 * check ownership based on the path. The admin role check is an exception
 * that requires one `get()` call to check the requesting user's own role.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     * This is the primary function for verifying document ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks for ownership on an existing document. Used for update and delete
     * operations to prevent acting on non-existent data.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && exists(/databases/$(database)/documents/users/$(userId));
    }

    /**
     * Checks if the requesting user has the 'admin' role by reading their
     * own user profile document.
     */
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    /**
     * Validates that the user document being created has an 'id' field
     * that matches the document's ID (which is the user's UID).
     * This enforces relational integrity from the start.
     */
    function hasValidUserDataOnCreate(userId) {
      // On creation, users are assigned default values.
      let data = request.resource.data;
      return data.id == userId
        && data.role == 'user'
        && data.plan == 'Free'
        && data.storageAllocation == 0.1
        && data.transcriptionAllocation == 15
        && data.storageUsed == 0
        && data.transcriptionUsed == 0
        && data.notificationSettings.activityDigest == 'weekly'
        && data.notificationSettings.ingestSuccess == true
        && data.notificationSettings.ingestFail == true
        && data.storageSettings.deletionPolicy == 'never'
        && data.timezone is string;
    }

    /**
     * Validates that key user data fields are immutable.
     * Prevents re-assigning the core identity or email of a user profile.
     * Admins can change roles and allocations, but users cannot.
     */
    function isUserDataImmutable() {
      let isRoleUnchanged = request.resource.data.role == resource.data.role;
      let isPlanUnchanged = request.resource.data.plan == resource.data.plan;
      let isAllocationUnchanged = request.resource.data.storageAllocation == resource.data.storageAllocation 
                                  && request.resource.data.transcriptionAllocation == resource.data.transcriptionAllocation;
                                  
      // Users cannot change their own role, plan, or allocations. Only admins can.
      let canChangeSensitiveFields = isRoleUnchanged && isPlanUnchanged && isAllocationUnchanged;

      return request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && (canChangeSensitiveFields || isAdmin());
    }

    /**
     * Validates that a subcollection document (e.g., Contact, Recording)
     * being created has a 'userId' field that correctly points back to the
     * owner specified in the path.
     */
    function hasValidSubcollectionDataOnCreate(userId) {
      return request.resource.data.userId == userId;
    }

    /**
     * Validates that the 'userId' field in a subcollection document is
     * immutable, preventing a document from being moved between users.
     */
    function isSubcollectionDataImmutable() {
      return request.resource.data.userId == resource.data.userId;
    }


    // ----------------------------------------------------------------------
    // User Profiles
    // ----------------------------------------------------------------------

    /**
     * @description Manages user profile documents.
     * @path /users/{userId}
     * @allow (get) A user reading their own profile or an admin reading any profile.
     * @allow (list) An admin listing all user profiles.
     * @allow (update) A user can update their own profile's mutable fields. Admins can update roles.
     * @deny (list) A non-admin user trying to list all profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && hasValidUserDataOnCreate(userId);
      allow update: if isExistingOwner(userId) && isUserDataImmutable();
      allow delete: if isExistingOwner(userId);
    }

    // ----------------------------------------------------------------------
    // User Contacts
    // ----------------------------------------------------------------------

    /**
     * @description Manages the contacts belonging to a specific user.
     * @path /users/{userId}/contacts/{contactId}
     * @allow (read) An authenticated user accessing their own contacts, or an admin.
     * @deny (list) A non-admin user trying to list another user's contacts.
     * @principle Enforces document ownership for write/delete, but allows admin read access.
     */
    match /users/{userId}/contacts/{contactId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && hasValidSubcollectionDataOnCreate(userId);
      allow update: if isExistingOwner(userId) && isSubcollectionDataImmutable();
      allow delete: if isExistingOwner(userId);
    }

    // ----------------------------------------------------------------------
    // User Recordings
    // ----------------------------------------------------------------------

    /**
     * @description Manages the audio recordings belonging to a specific user.
     * @path /users/{userId}/recordings/{recordingId}
     * @allow (read) An authenticated user accessing their own recordings, or an admin.
     * @deny (update) A non-admin user trying to modify another user's recording.
     * @principle Enforces document ownership for write/delete, but allows admin read access.
     */
    match /users/{userId}/recordings/{recordingId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && hasValidSubcollectionDataOnCreate(userId);
      allow update: if isExistingOwner(userId) && isSubcollectionDataImmutable();
      allow delete: if isExistingOwner(userId);
    }
  }
}
