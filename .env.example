# ==============================================================================
# Vosift — complete environment template for self-host and managed deployments
#
# Copy this ONE file to .env in the repository root. Every supported integration
# is configured below; no second environment template is needed.
#   Bash:       cp .env.example .env
#   PowerShell: Copy-Item .env.example .env
#
# SELF-HOST WITHOUT DOCKER (defaults below):
#   Keep billing=false; Better Auth with MongoDB serves every deployment.
#   Set BETTER_AUTH_SECRET, ADMIN_EMAILS, MONGODB_URI and all four R2_* fields.
#   Use your own MongoDB server/Atlas cluster and S3-compatible storage.
#   R2: S3_REGION=auto, S3_FORCE_PATH_STYLE=false, S3_PUBLIC_ENDPOINT empty.
#   Run pnpm install --frozen-lockfile, pnpm run db:init, then pnpm run dev.
#   The dev server uses http://localhost:9000.
#
# SELF-HOST WITH DOCKER COMPOSE (same file, bundled MongoDB + MinIO):
#   Change these assignments in their sections below before starting:
#     NEXT_PUBLIC_APP_URL=http://localhost:3000
#     MONGODB_URI=mongodb://mongo:27017/vosift
#     R2_ENDPOINT=http://minio:9000
#     S3_PUBLIC_ENDPOINT=http://localhost:9000
#     S3_REGION=us-east-1
#     S3_FORCE_PATH_STYLE=true
#   Set both R2 credential fields to your chosen MinIO credentials (min 8 chars),
#   BETTER_AUTH_SECRET and CRON_SECRET. R2_BUCKET_NAME names the bundled bucket.
#   Run docker compose --profile selfhost up --build -d.
#   Compose initializes the database, bucket and scheduler automatically.
#   Docker with external MongoDB/storage: keep your external endpoints, run
#   pnpm run db:init, then docker compose --profile scheduler up --build -d.
#   The Docker app still uses http://localhost:3000; set NEXT_PUBLIC_APP_URL too.
#
# Profiles — one codebase; public settings must be selected before building:
#   SELF-HOST ... Better Auth + MongoDB, billing disabled, S3-compatible storage.
#   MANAGED ..... Same authentication; billing can use Stripe and metered plans.
#   BOTH ......... Configure SMTP or Resend for deployed verification/recovery.
#                 Transcription, AI, Google, email and push are optional.
#                 Set CRON_SECRET and arrange scheduled jobs for exports/cleanup.
#
# Labels used below:
#   [REQUIRED]            app throws an actionable error without it.
#   [REQUIRED IF ...]     required only in that mode; ignored otherwise.
#   [OPTIONAL]            safe to leave empty; the noted default applies.
#   [BUILD-TIME ONLY]     only read during `next build`, never at runtime.
#
# Gotchas:
#   * NEXT_PUBLIC_* vars bake into the client bundle AT BUILD TIME. After
#     changing one, rebuild/restart. Auth capabilities are read from the server.
#   * Never commit your real `.env`. Quote values containing # or spaces:
#     SECRET="abc#123". Next.js expands $ references; escape a literal $ as \$.
#   * Generate a new value for each application secret (not provider API keys):
#     node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#   * Full prose guide: docs/setup-guide.md (storage recipes, provider tiers,
#     fully-local Ollama + Whisper setups). This file is the variable reference.
# ==============================================================================


# --- Core (BOTH profiles) ------------------------------------------------
# [REQUIRED] MongoDB connection string. Database name comes from the path.
#   Local:            mongodb://localhost:27017/vosift
#   Compose selfhost: mongodb://mongo:27017/vosift
#   Atlas:            mongodb+srv://<user>:<pass>@<cluster>/vosift?retryWrites=true&w=majority
#   Choose a database name in the URI; no manual database creation is needed.
#   pnpm run db:init creates collections/indexes and initial settings. The
#   MongoDB server/cluster and database user must already exist.
#   NOTE: semantic (vector) + full-text search need Atlas Search indexes —
#   on self-hosted MongoDB semantic search is unavailable and keyword search
#   falls back to regex. Everything else works identically.
MONGODB_URI=mongodb://localhost:27017/vosift
# [OPTIONAL] MongoDB SRV DNS fallback settings. Leave empty to use app defaults.
#   DNS servers are comma-separated IP addresses; mode is default or fallback-first.
MONGODB_DNS_SERVERS=
MONGODB_CONNECTION_MODE=

# [REQUIRED in production] Public base URL of the app, no trailing slash.
#   Used for auth callbacks, OAuth redirect fallback, and email links.
#   Native dev: http://localhost:9000. Docker Compose: http://localhost:3000.
#   A remote deployment must use its browser-reachable HTTPS URL.
NEXT_PUBLIC_APP_URL=http://localhost:9000


# --- Authentication: Better Auth + MongoDB (both profiles) ----------------
# [REQUIRED] Session/encryption secret: at least 32 characters, randomly generated.
#   Generate with the Node command above or openssl rand -base64 32.
#   Keep stable; changing it invalidates sessions and derived feature tokens.
BETTER_AUTH_SECRET=
# [OPTIONAL] Comma-separated emails granted admin after verified authentication,
#   including email-verification completion. With EMAIL_PROVIDER=none, accounts
#   verify automatically for testing. Empty = no bootstrap admins.
ADMIN_EMAILS=


# --- Email: resend | smtp | none ------------------------------------------
# [OPTIONAL, default: none] Who sends verification + password-reset mail.
#   resend = Resend API (recommended for anything real).
#   smtp   = your own relay (self-host friendly; dev tip: Ethereal test accounts).
#   none   = send nothing; accounts verify implicitly. Development only —
#            in production anyone could register with any address.
#   none disables password recovery. Use SMTP/Resend for deployed instances.
EMAIL_PROVIDER=none
# [REQUIRED IF EMAIL_PROVIDER=resend|smtp] Sender identity.
#   Resend requires a verified domain: EMAIL_FROM=Vosift <noreply@yourdomain.com>
EMAIL_FROM=Vosift <noreply@example.com>
# [REQUIRED IF EMAIL_PROVIDER=resend] Where: https://resend.com/api-keys
RESEND_API_KEY=
# [REQUIRED IF EMAIL_PROVIDER=smtp] Relay hostname, e.g. smtp.gmail.com / mailpit / 127.0.0.1
SMTP_HOST=
# [OPTIONAL, default: 587] Port. Common: 587 (STARTTLS), 465 (implicit TLS), 25/1025 (local).
SMTP_PORT=587
# [OPTIONAL] true = implicit TLS. Default: true when port is 465, else false.
#   Leave empty unless your relay disagrees with that rule.
SMTP_SECURE=false
# [OPTIONAL] Relay credentials. Empty = no auth (local relays like Mailpit).
SMTP_USER=
SMTP_PASS=
# [OPTIONAL] Inbox for the /support contact form. Default: EMAIL_FROM.
SUPPORT_EMAIL=
# [REQUIRED for cron jobs] Shared secret guarding /api/cron/* (retention
# purges, activity digests). Vercel Cron sends it automatically when set;
# external schedulers must send `Authorization: Bearer <CRON_SECRET>`.
# Generate: openssl rand -hex 32
CRON_SECRET=


# --- Object storage: any S3-compatible backend --------------------------------
# [REQUIRED, all four] Names are historical (R2-first); any endpoint works:
#   MinIO, Cloudflare R2, AWS S3, Hetzner, Backblaze B2, ...
#   External backends need a pre-created bucket. Fill in YOUR credentials.
#   R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region auto,
#       path style false, public endpoint empty. Use an R2 Object Read & Write key.
#       Keep the bucket private; allow the app origin in the bucket's CORS policy.
#   AWS: your regional S3 endpoint + region, path style false, public endpoint empty.
#   MinIO: endpoint http://<host>:<port>, region us-east-1, path style true.
#       Docker Compose uses the MinIO endpoints listed at the top of this file.
#       Only Docker Compose creates its bundled MinIO bucket automatically.
#       Cloudflare R2, AWS S3, and external MinIO use your existing R2_BUCKET_NAME bucket.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vosift
# [OPTIONAL, default: auto] Region. R2 wants `auto`; MinIO/AWS want a real
#   region such as `us-east-1`.
S3_REGION=auto
# [OPTIONAL, default: false] true = path-style URLs (http://host:9000/bucket/key).
#   Needed for MinIO and most self-hosted S3 clones. R2/AWS use virtual-hosted
#   style: leave false/unset for them.
S3_FORCE_PATH_STYLE=false
# [OPTIONAL] Base URL the BROWSER uses for presigned playback links.
#   Set it whenever the browser reaches storage at a DIFFERENT address than the
#   server (Docker: server http://minio:9000, browser http://localhost:9000).
#   Omit when both use the same address (falls back to R2_ENDPOINT).
#   NOTE: URLs are SIGNED with this host — a wrong value breaks playback, not uploads.
#   For R2 leave this empty; an r2.dev/custom public domain cannot replace the
#   S3 API endpoint for signed playback URLs.
S3_PUBLIC_ENDPOINT=


# --- Transcription: soniox | elevenlabs | gemini | openai_compat ---------------
# [OPTIONAL, default: soniox] Instance-wide default backend. Users can override
#   per-account in Settings → Data Processing (each override needs its own key).
#   Tiers: soniox/elevenlabs = word timestamps + speaker diarization.
#          gemini           = budget tier; timestamps best-effort, diarization
#                             approximate — verify quality on your audio first.
#          openai_compat    = any Whisper-API server; word timestamps, no
#                             diarization; the fully self-hostable tier.
#   Choose one provider and configure its credentials below. For an upload/playback
#   trial without transcription, turn off auto-transcription in user settings.
TRANSCRIPTION_PROVIDER=soniox
# [OPTIONAL] Billed-unit multipliers applied to raw seconds for managed metering.
#   Self-host writes the same usage ledger with gates open. Unknown providers bill 1x.
#   Defaults if unset: {"soniox":1,"elevenlabs":5,"gemini":0.5,"openai_compat":0.1}
TRANSCRIPTION_PRICING_JSON={"soniox":1,"elevenlabs":5,"gemini":0.5,"openai_compat":0.1}
# [REQUIRED IF provider is (or may be) soniox] Where: https://soniox.com/account/keys
SONIOX_API_KEY=
# [OPTIONAL, default: https://api.soniox.com] Override for proxies/mocks only.
SONIOX_API_BASE_URL=https://api.soniox.com
# [OPTIONAL, default: stt-async-v3]
SONIOX_MODEL_ID=stt-async-v3
# [REQUIRED IF provider is (or may be) elevenlabs] Where: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# [OPTIONAL, default: https://api.elevenlabs.io] Override for proxies/mocks only.
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
# [OPTIONAL, default: scribe_v2]
ELEVENLABS_MODEL_ID=scribe_v2
# [OPTIONAL, default: gemini-2.5-flash] Transcription model when the provider
#   is gemini. Auth comes from GOOGLE_GENERATIVE_AI_API_KEY below (shared key).
GEMINI_MODEL_TRANSCRIPTION=
# [REQUIRED IF using Soniox/ElevenLabs webhook transcription] Authenticate provider
#   callbacks. Long recordings (over 5 minutes) use callbacks for these providers.
#   The app URL must be publicly reachable. Leave blank for Gemini/openai_compat.
#   Soniox: generate a random secret; Vosift sends it with the transcription request.
#   ElevenLabs: use the signing secret from your ElevenLabs webhook configuration.
SONIOX_WEBHOOK_SECRET=
ELEVENLABS_WEBHOOK_SECRET=


# --- Text AI (summaries, transliteration, embeddings): gemini | openai_compat --
# [OPTIONAL, default: gemini]
#   gemini       = Google AI, single shared key below.
#   openai_compat = any OpenAI-API chat + embeddings server (Ollama, vLLM,
#                  OpenAI, ...). Fully local example: Ollama with a chat model
#                  + an embedding model; pair with a Whisper-API server above
#                  and the whole pipeline runs offline.
AI_PROVIDER=gemini
# [REQUIRED IF AI_PROVIDER=gemini and you want AI features, or TRANSCRIPTION_PROVIDER=gemini]
#   One shared key: transcription (gemini) + summaries + transliteration + embeddings.
#   Without it (and without openai_compat), transcripts save without AI extras.
#   Where: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# [OPTIONAL, default: gemini-2.5-flash] Summary model.
GEMINI_MODEL_SUMMARY=
# [OPTIONAL, default: gemini-2.5-flash] Transliteration model.
GEMINI_MODEL_TRANSLITERATION=
# [OPTIONAL, default: gemini-embedding-001] Embedding model; Atlas vector-index
#   dimensions must match its output. Changing it requires re-embedding stored data.
GEMINI_MODEL_EMBEDDING=gemini-embedding-001
# [REQUIRED IF AI_PROVIDER=openai_compat] Chat + embeddings server. MUST include
#   the version path, e.g. http://localhost:11434/v1 — not the bare host.
OPENAI_COMPAT_BASE_URL=
# [OPTIONAL] API key for the server above. Empty = no auth (local Ollama etc.).
OPENAI_COMPAT_API_KEY=
# [REQUIRED IF AI_PROVIDER=openai_compat] Model names as the server knows them.
OPENAI_COMPAT_CHAT_MODEL=
OPENAI_COMPAT_EMBEDDING_MODEL=
# WARNING: every embedding model emits a fixed vector width. Switching embedding
# models (or AI providers) without re-embedding breaks vector search — the app
# fails fast with a dimension-mismatch error. Pick one embedding model per
# deployment and stay on it (the Atlas vector index dimensions must match it too).
# [REQUIRED IF TRANSCRIPTION_PROVIDER=openai_compat] Whisper-API server
#   (own section: these servers usually don't do chat). Again, include /v1.
TRANSCRIPTION_COMPAT_BASE_URL=
# [OPTIONAL] Key for the Whisper server. Empty = no auth (local servers).
TRANSCRIPTION_COMPAT_API_KEY=
# [REQUIRED IF TRANSCRIPTION_PROVIDER=openai_compat, default when read: whisper-1]
TRANSCRIPTION_COMPAT_MODEL=whisper-1


# --- Google (optional in BOTH profiles: Contacts sync + Google sign-in) --------
# [OPTIONAL] One Google OAuth WEB client serves login/signup and Contacts.
#   Configure BOTH credentials to enable Google login; partial config errors name
#   the missing variable. The client secret is server-only.
#   Register BOTH exact redirect URIs on the same OAuth client:
#     Login:    http://localhost:9000/api/auth/callback/google
#     Contacts: http://localhost:9000/api/auth/google/callback
#   Replace the origin for your deployment (Compose defaults to localhost:3000).
#   Login requests identity scopes only. Connecting Contacts separately requests
#   contacts.readonly; enable the People API and configure OAuth consent/test users.
#   Where: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client.
#   OAuth guidance: https://developers.google.com/identity/protocols/oauth2/web-server
#   The Gemini API key is separate from OAuth credentials and Contacts access.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# [REQUIRED IF the client ID above is set] Client secret from the same screen.
GOOGLE_CLIENT_SECRET=
# [OPTIONAL] Contacts-only OAuth redirect URI. Default: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
#   Set explicitly only if Google Console lists a different URI (must match EXACTLY,
#   including http vs https — mismatches cause redirect_uri_mismatch errors).
#   Dev:     http://localhost:9000/api/auth/google/callback
#   Compose: http://localhost:3000/api/auth/google/callback
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=
# [REQUIRED IF Google Contacts sync is enabled] Encrypts stored Google refresh
#   tokens. Generate a separate random secret using the Node command at the top.
#   Keep it stable; replacing it requires users to reconnect their Google accounts.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# [OPTIONAL, default: v1] Version label for the encryption key, not another secret.
GOOGLE_TOKEN_ENCRYPTION_KEY_VERSION=v1


# --- Billing (managed profile; self-host leaves disabled) ----------------------
# [OPTIONAL, default: false] true = quotas enforce, Stripe is called, pricing/
#   billing UI shows. Anything else (including empty) = billing off entirely.
NEXT_PUBLIC_ENABLE_BILLING=false
# [REQUIRED IF billing enabled] Secret key. Where: https://dashboard.stripe.com/apikeys
#   Test: sk_test_...  Live: sk_restricted_... or sk_live_... (prefer restricted).
STRIPE_SECRET_KEY=
# [REQUIRED IF billing enabled] Webhook signing secret for subscription sync.
#   Without it the /api/stripe/webhook route returns 500 (checkout still works,
#   but plan changes won't sync). Where: Stripe Dashboard > Developers > Webhooks
#   > your endpoint > Signing secret (whsec_...). Dev: `stripe listen --forward-to`.
STRIPE_WEBHOOK_SECRET=


# --- UI flags ------------------------------------------------------------------
# [OPTIONAL, default: false] true = show the hamburger menu on mobile instead
#   of the bottom navigation bar. Anything else (including empty) = bottom nav.
NEXT_PUBLIC_SHOW_MOBILE_BURGER_MENU=false


# --- Sentry (optional; app runs fully without it) -------------------------------
# [OPTIONAL] Runtime error-reporting DSN (server + edge + browser). Unset = SDK
#   stays a no-op client. Where: Sentry > Project settings > Client Keys (DSN).
SENTRY_DSN=
# [OPTIONAL] Same DSN, browser-visible name. The client bundle cannot read
#   SENTRY_DSN, so set this too or browser error reporting stays silent.
NEXT_PUBLIC_SENTRY_DSN=
# [BUILD-TIME ONLY, OPTIONAL] Source-map upload + release tracking during builds.
#   Never needed to RUN the app. SENTRY_ORG is the org slug; the token needs
#   `project:releases` scope: Sentry > Settings > Auth Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# [BUILD-TIME ONLY, OPTIONAL] Override the Sentry URL for a self-hosted Sentry server.
SENTRY_URL=


# --- Runtime (usually NOT set in .env) -------------------------------------------
# NODE_ENV            Set by scripts/Dockerfile (development | production | test).
#                     Dev server: development. Dockerfile CMD: production.
# PORT                Compose/Dockerfile use 3000; `pnpm run dev` forces 9000
#                     (see package.json). Override at runtime, not in .env:
#                       PORT=3001 next start
# NEXT_TELEMETRY_DISABLED=1  Set in the Dockerfile already; add to .env only to
#                     silence telemetry for local `pnpm run dev` too.
# NEXT_RUNTIME        Set automatically by Next.js (nodejs | edge). Never set it
#                     yourself; read-only in instrumentation.ts.
#

# --- Application signing secrets (BOTH profiles) -----------------------------
# [OPTIONAL] Precedence: dedicated feature secret, then APP_SIGNING_SECRET,
#   then a purpose-specific key derived from BETTER_AUTH_SECRET.
APP_SIGNING_SECRET=
# [OPTIONAL with a shared secret] Signs upload tokens to prevent metadata tampering.
UPLOAD_SESSION_SECRET=
# [OPTIONAL with a shared secret] Signs recording share links to prevent tampering.
SHARE_LINK_SECRET=
# [OPTIONAL with a shared secret] Signs temporary mobile-sync authorization tokens.
MOBILE_SYNC_SESSION_SECRET=

# --- Browser push notifications (optional in BOTH profiles) ------------------
# [REQUIRED IF push is enabled] Generate a matching VAPID public/private key pair:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#   These are a key pair, not two independently generated random secrets.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# [REQUIRED IF push is enabled] Your contact email address (without the mailto: prefix).
VAPID_CONTACT_EMAIL=

# --- Operations (BOTH profiles) ----------------------------------------------
# [OPTIONAL, default: 30] Minutes before an export job is considered stale.
EXPORT_JOB_STALE_MINUTES=30
# [OPTIONAL, default: 30] Days before a soft-deleted account is permanently removed.
SOFT_DELETE_RESTORE_DAYS=30
# [OPTIONAL, default: false] Report CSP violations without enforcing the policy.
CSP_REPORT_ONLY=false
