# Base app URL used for OAuth callbacks, webhook metadata, and public share links.
NEXT_PUBLIC_APP_URL=http://localhost:9000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/call-memo
# Only needed if your environment has DNS resolution issues with Atlas SRV records.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Firebase client config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Firebase Admin
# Choose one:
# 1) Put service-account.json in the repo root for local development
# 2) Set the full JSON string here for container/hosted environments
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Cloudflare R2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Signing secrets
UPLOAD_SESSION_SECRET=
SHARE_LINK_SECRET=
# NEXTAUTH_SECRET=  # legacy fallback only

# Feature flags
NEXT_PUBLIC_ENABLE_BILLING=false
NEXT_PUBLIC_SHOW_MOBILE_BURGER_MENU=false

# Google Contacts OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:9000/api/auth/google/callback
# GOOGLE_CLIENT_ID=  # optional legacy/server-side alias

# Gemini
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=  # legacy fallback
GEMINI_MODEL_SUMMARY=gemini-2.0-flash-lite-preview-02-05
GEMINI_MODEL_TRANSLITERATION=gemini-2.0-flash-lite-preview-02-05

# Soniox
# SONIOX_API_KEY=
SONIOX_API_BASE_URL=https://api.soniox.com
SONIOX_MODEL_ID=stt-async-v3
# SONIOX_WEBHOOK_SECRET=

# ElevenLabs
# ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_ID=scribe_v2
# ELEVENLABS_WEBHOOK_SECRET=

# Stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Web Push
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=admin@example.com

# Email / support
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM="Call Memo <no-reply@example.com>"
# SUPPORT_EMAIL=support@example.com

# Cron / export processing
# CRON_SECRET=
EXPORT_JOB_STALE_MINUTES=90
EXPORT_INLINE_PROCESSING=false
SOFT_DELETE_RESTORE_DAYS=30
