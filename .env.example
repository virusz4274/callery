#'development', 'test', or 'production'.
NODE_ENV=production

# Fresh deployment template for a single Google Cloud project with Firebase enabled.
# Base app URL used for OAuth callbacks, webhook metadata, and public share links.
NEXT_PUBLIC_APP_URL=http://localhost:9000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/callery
# For the bundled Docker Compose MongoDB service, use:
# MONGODB_URI=mongodb://mongo:27017/callery
# Use "fallback-first" if Atlas SRV DNS resolution is slow or flaky in your environment.
MONGODB_CONNECTION_MODE=default
# Only needed if your environment has DNS resolution issues with Atlas SRV records.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Firebase client config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional explicit helper origin for /__/auth/* rewrites.
# FIREBASE_AUTH_HELPER_ORIGIN=https://your-project.firebaseapp.com

# Firebase Admin
# Choose one:
# 1) Put service-account.json in the repo root for local development
# 2) Set the full JSON string here for container/hosted environments
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
R2_FORCE_PATH_STYLE=false

# Signing secrets
UPLOAD_SESSION_SECRET=
SHARE_LINK_SECRET=
MOBILE_SYNC_SESSION_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_TOKEN_ENCRYPTION_KEY_VERSION=v1

# Feature flags
NEXT_PUBLIC_ENABLE_BILLING=false
NEXT_PUBLIC_SHOW_MOBILE_BURGER_MENU=false
# Enable report-only CSP on staging/preview while validating browser allowlists.
CSP_REPORT_ONLY=false

# Google Contacts OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:9000/api/auth/google/callback

# First-login bootstrap admin allowlist
ADMIN_BOOTSTRAP_EMAILS=admin@example.com

# Gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL_SUMMARY=gemini-2.5-flash-lite
GEMINI_MODEL_TRANSLITERATION=gemini-2.5-flash-lite
GEMINI_MODEL_EMBEDDING=gemini-embedding-001

# Soniox
SONIOX_API_KEY=
SONIOX_API_BASE_URL=https://api.soniox.com
SONIOX_MODEL_ID=stt-async-v4
SONIOX_WEBHOOK_SECRET=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_ID=scribe_v2
ELEVENLABS_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=admin@example.com

# Email / support
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Callery <no-reply@example.com>"
SUPPORT_EMAIL=support@example.com

# Cron / export processing
CRON_SECRET=
# Protects /api/cron/process-async-jobs in addition to the existing cron routes.
EXPORT_JOB_STALE_MINUTES=90
EXPORT_INLINE_PROCESSING=true
SOFT_DELETE_RESTORE_DAYS=30

# Sentry (Optional – leave blank to disable error tracking)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_AUTH_TOKEN=sntrys_replace-me
