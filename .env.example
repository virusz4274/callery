# ==============================================================================
# Vosift / CallOrganizer — environment template
# Copy to `.env` and fill in. Same image runs two profiles:
#
#   SELF-HOST ... MongoDB + any S3-compatible storage + one transcription key.
#                 Billing off, local auth available, no Firebase/Stripe needed.
#   MANAGED ..... everything below: Firebase + Stripe + Resend + providers.
# ==============================================================================

# --- Core ---
MONGODB_URI=mongodb://localhost:27017/vosift
NEXT_PUBLIC_APP_URL=http://localhost:9000

# --- Auth: firebase | local ---
# firebase = Firebase Auth (managed default). local = built-in email/password
# via better-auth with sessions in MongoDB (self-host default).
AUTH_PROVIDER=local
# Client-side mirror of AUTH_PROVIDER. The two MUST match: server code reads
# AUTH_PROVIDER, browser code reads this (NEXT_PUBLIC_ vars bake at build).
NEXT_PUBLIC_AUTH_PROVIDER=local
# Firebase web config (AUTH_PROVIDER=firebase, or self-hosters who prefer it)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Admin: prefer this env var in containers; a (gitignored)
# service-account.json in the project root also works for local dev.
FIREBASE_SERVICE_ACCOUNT=
# Local auth: comma-separated emails granted admin on first login.
ADMIN_EMAILS=
# Local auth: session encryption secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Email: resend | smtp | none ---
# Required by local auth for verification + password-reset mails.
# Firebase mode uses Firebase's built-in emails and ignores this section.
EMAIL_PROVIDER=none
EMAIL_FROM=Vosift <noreply@example.com>
# Resend (recommended for managed)
RESEND_API_KEY=
# SMTP (self-host your own relay; dev tip: Ethereal test accounts)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Object storage: any S3-compatible backend (MinIO, Cloudflare R2, AWS S3)
# Names are historical; any endpoint works. MinIO example values shown.
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=change-me-min-8-chars
R2_BUCKET_NAME=vosift
# R2 uses `auto`; MinIO/AWS use a real region such as `us-east-1`.
S3_REGION=us-east-1
# MinIO and most self-hosted S3 backends need path-style requests.
S3_FORCE_PATH_STYLE=true
# Public base URL for presigned playback URLs (browser-facing). Falls back
# to R2_ENDPOINT when the same address works for server and browser.
S3_PUBLIC_ENDPOINT=

# --- Transcription: soniox | elevenlabs | gemini | openai_compat ---
# Env default; users can override per-account in settings.
TRANSCRIPTION_PROVIDER=soniox
# Billed-unit multipliers applied to raw seconds for managed metering.
# Self-host tracks the same ledger with gates open.
TRANSCRIPTION_PRICING_JSON={"soniox":1,"elevenlabs":5,"gemini":0.5,"openai_compat":0.1}
SONIOX_API_KEY=
SONIOX_API_BASE_URL=https://api.soniox.com
SONIOX_MODEL_ID=stt-async-v3
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=scribe_v2
# Single Gemini key: powers transcription (gemini provider), summaries, transliteration, and embeddings.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL_SUMMARY=
GEMINI_MODEL_TRANSLITERATION=
# Transcription model when TRANSCRIPTION_PROVIDER=gemini (default: gemini-2.5-flash).
GEMINI_MODEL_TRANSCRIPTION=

# --- Text AI (summaries, transliteration, embeddings): gemini | openai_compat ---
AI_PROVIDER=gemini
# OpenAI-compatible chat + embeddings server (Ollama, vLLM, OpenAI, ...). Include /v1.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_CHAT_MODEL=
OPENAI_COMPAT_EMBEDDING_MODEL=
# Whisper-API transcription server (own section: these servers usually don't do chat).
# Used when TRANSCRIPTION_PROVIDER=openai_compat (env default or per-user override).
TRANSCRIPTION_COMPAT_BASE_URL=
TRANSCRIPTION_COMPAT_API_KEY=
TRANSCRIPTION_COMPAT_MODEL=whisper-1

# --- Google Contacts sync (optional; UI hides when unconfigured) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=

# --- Billing (managed profile; self-host leaves disabled) ---
NEXT_PUBLIC_ENABLE_BILLING=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Sentry (optional; app runs fully without it) ---
SENTRY_DSN=
# Build-time source-map upload only. Never needed to run the app.
SENTRY_ORG=
SENTRY_AUTH_TOKEN=
