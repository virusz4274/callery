---
import SiteLayout from '../layouts/SiteLayout.astro';
import LaunchStatus from '../components/LaunchStatus.astro';
import { appUrl, siteConfig, siteUrl } from '../lib/site';
import { pricingSnapshot, formatPrice, formatStorage } from '../lib/pricing';
const pricing = siteConfig.comingSoon ? undefined : pricingSnapshot?.pricing;
const plans = pricing?.plans ?? [];
const trial = pricing?.trial;
const cadence = (interval: string) => interval === 'lifetime' ? 'once' : interval === 'yearly' ? 'per year' : 'per month';
const number = (value: number) => new Intl.NumberFormat('en-US', { maximumFractionDigits: 2 }).format(value);
const usd = (value: string) => `$${value.replace(/(\.\d*?[1-9])0+$|\.0+$/, '$1')}`;
const storage = (plan: typeof plans[number]) => plan.storageBytes === null ? 'See current plan details' : plan.interval === 'lifetime' && plan.storageBytes === 0 ? 'Storage paid as you use it' : `${formatStorage(plan.storageBytes)} storage included`;
const transcription = (plan: typeof plans[number]) => plan.weightedMinutes === null ? 'See current plan details' : plan.interval === 'lifetime' && plan.weightedMinutes === 0 ? 'Transcription paid as you use it' : `${number(plan.weightedMinutes)} weighted transcription minutes per month`;
const offers = plans.filter(plan => plan.available).map(plan => ({ '@type': 'Offer', name: plan.name, price: plan.price, priceCurrency: plan.currency, url: appUrl('/pricing'), availability: 'https://schema.org/InStock', description: `${cadence(plan.interval)}; ${storage(plan)}; ${transcription(plan)}` }));
const description = siteConfig.comingSoon ? 'Managed Callery is launching soon. Pricing will be announced. Explore the demo or self-host Callery now.' : 'Choose managed Callery hosting for your personal call archive, or self-host for free. Compare storage, transcription, and usage details.';
const schema = { '@type': 'SoftwareApplication', name: 'Callery', url: siteUrl('/'), operatingSystem: 'Web', applicationCategory: 'UtilitiesApplication', description, ...(offers.length > 0 ? { offers } : {}) };
---
<SiteLayout title="Plans and pricing" description={description} schema={schema} noIndex={siteConfig.comingSoon}>
  {siteConfig.comingSoon ? <>
    <section class="container page-heading"><h1>Managed Callery<br />is launching soon.</h1><p>Pricing will be announced when managed signup opens. You can explore the demo and use the open-source, self-hosted app now.</p></section>
    <section class="container pricing-content" aria-label="Managed Callery availability"><div class="pricing-introduction"><div><LaunchStatus /><h2>Keep your call history close.</h2><p>Organize original recordings by contact and date, listen back, and add transcripts when you need to search what was said.</p><div class="actions"><a class="button" href={siteConfig.demoUrl}>Watch the demo</a><a class="button button-secondary" href="/self-host">Explore self-hosting</a></div></div><div class="included"><h3>Start with your recordings</h3><ul><li>Check that original files are accessible in your phone's file manager</li><li>Preserve filenames for caller and date recognition</li><li>Copy a small sample before importing your archive</li></ul><a class="text-link" href="/phone-compatibility">Check phone compatibility</a></div></div></section>
  </> : <>
  <section class="container page-heading"><h1>A home for your calls.<br />Room to keep growing.</h1><p>Use managed Callery and let us handle the hosting. Choose the storage and optional transcription that fit your recording collection.</p></section>
  <section class="container pricing-content" aria-label="Callery plans">
    {(plans.length > 0 || trial) ? <><div class="plan-grid" style={`--plan-count:${plans.length + (trial ? 1 : 0)}`}>
      {trial && <article class="plan"><span class="plan-intro">Start with your own recordings</span><h2>{trial.name}</h2><p>{trial.description}</p><div class="plan-price">{formatPrice(0, trial.currency)}<span>for {trial.durationDays} days</span></div><a class="button button-secondary" href={appUrl('/signup')}>Start free trial</a><ul><li>{formatStorage(trial.storageBytes)} storage included</li><li>{number(trial.weightedMinutes)} weighted transcription minutes</li><li>No credit card needed</li></ul></article>}
      {plans.map(plan => <article class:list={['plan', { 'plan-featured': plan.key === 'pro' }]}><span class="plan-intro">{plan.interval === 'lifetime' ? 'One-time access purchase' : 'Managed hosting'}</span><h2>{plan.name}</h2><p>{plan.description}</p><div class="plan-price">{formatPrice(plan.price, plan.currency)}<span>{cadence(plan.interval)}</span></div><a class:list={['button', { 'button-secondary': plan.key !== 'pro' }]} href={appUrl('/pricing')}>{plan.available ? `Choose ${plan.name}` : 'Check availability'}</a><ul><li>{storage(plan)}</li><li>{transcription(plan)}</li><li>{plan.interval === 'lifetime' ? 'Access, with storage and processing paid separately' : 'Prepaid credit for usage beyond your allowances'}</li></ul></article>)}
    </div><p class="pricing-note">Review the current plan and final price in Callery before purchase. Hosted plans are for individual accounts.</p></> : <div class="pricing-introduction"><div><h2>Choose your plan in Callery.</h2><p>Your archive has its own shape. See the current hosting plans, included storage, and transcription allowances in the app before you decide.</p><a class="button" href={appUrl('/pricing')}>View current plans</a></div><div class="included"><h3>One place for the whole conversation</h3><ul><li>Original audio, organized by contact and date</li><li>Playback in your phone or computer’s browser</li><li>Optional transcripts, summaries, and search</li><li>Downloadable recording archives</li></ul></div></div>}
  </section>
  {plans.some(plan => plan.usage) && <section class="container section usage-section"><div class="section-intro"><h2>Understand the extra usage.</h2><p>Paid plans use included allowances first. Additional storage and processing use prepaid credit. Lifetime access has storage and transcription charged separately.</p></div><div class="usage-list">{plans.filter(plan => plan.usage).map(plan => <details><summary>{plan.name} usage rates<span aria-hidden="true">+</span></summary><div class="usage-content"><div class="rates-scroll" tabindex="0" role="region" aria-label={`${plan.name} transcription rates`}><table><thead><tr><th scope="col">Transcription option</th><th scope="col">Per audio minute</th><th scope="col">Included minutes used</th></tr></thead><tbody>{plan.usage!.providers.map(provider => <tr><th scope="row">{provider.name}</th><td>{usd(provider.usdPerMinute)}</td><td>{number(provider.multiplier)}× audio length</td></tr>)}</tbody></table></div><p>Additional storage: {usd(plan.usage!.storageUsdPerGiB)} per GiB of monthly peak storage above your allowance.</p><p>{Number(plan.usage!.minimumRecordingUsd) === 0 ? 'No minimum charge per recording.' : `Minimum charge for a recording with extra usage: ${usd(plan.usage!.minimumRecordingUsd)}.`}</p></div></details>)}</div><p class="note">Audio time is rounded up to the next 15 seconds. A recording accepted for processing keeps its original rate.</p></section>}
  </>}
  <section class="container section plan-questions"><div><h2>Start with organizing.<br />Add processing when you need it.</h2><p>You can keep and listen to your original recordings without transcribing every call. Transcription, AI summaries, and search give you more ways to revisit the details.</p></div><div class="callout"><h3>Prefer your own server?</h3><p>Callery is free to self-host under AGPL-3.0. You operate the database, storage, email, and processing providers. Company archives are a self-hosted feature.</p><a class="text-link" href="/self-host">Explore self-hosting</a></div></section>
  {!siteConfig.comingSoon && <section class="closing"><div class="container"><div><h2>Bring your recordings.<br />We’ll handle the hosting.</h2><p>Open Callery to choose a plan or get your archive started.</p></div><a class="button" href={appUrl('/signup')}>Get started</a></div></section>}
</SiteLayout>
<style>
.pricing-content{padding-bottom:45px}.plan-grid{display:grid;grid-template-columns:repeat(var(--plan-count),minmax(0,1fr));border:1px solid #dce3ee;border-radius:14px;overflow:hidden}.plan{padding:29px 24px;display:flex;flex-direction:column;align-items:flex-start}.plan+.plan{border-left:1px solid #dce3ee}.plan-featured{background:#f3f6ff}.plan-intro{font-size:10px;font-weight:650;color:#52637a;margin-bottom:18px}.plan h2{font-size:25px;margin-bottom:12px}.plan>p{font-size:12px;line-height:1.85;min-height:67px;flex:1}.plan-price{font-size:37px;letter-spacing:-.055em;font-weight:650;line-height:1.2;margin:15px 0 27px}.plan-price span{display:block;font-size:11px;letter-spacing:0;color:#52637a;font-weight:500;margin-top:8px}.plan .button{width:100%;font-size:12px;min-height:45px;padding:12px 14px}.plan ul{list-style:none;padding:0;margin:25px 0 0;font-size:11px;line-height:1.9;color:#52637a}.plan li{padding-left:17px;position:relative;margin-block:11px}.plan li:before{content:'✓';position:absolute;left:0;color:#245be8}.pricing-note{font-size:11px;text-align:center;margin:23px 0 0}.pricing-introduction{display:grid;grid-template-columns:1.05fr 1fr;border:1px solid #dce3ee;border-radius:14px;overflow:hidden}.pricing-introduction>div{padding:40px}.pricing-introduction h2{font-size:30px;margin-bottom:18px}.pricing-introduction p{font-size:14px;line-height:1.9;max-width:48ch;margin-bottom:26px}.included{background:#eaf0ff}.included h3{font-size:20px;line-height:1.5;margin-bottom:25px}.included ul{padding-left:20px;margin:0;font-size:13px;line-height:1.9;color:#52637a}.included li{padding-left:5px;margin-block:15px}.plan-questions{display:grid;grid-template-columns:1fr 1fr;gap:95px;align-items:center;border-top:1px solid #dce3ee}.plan-questions>div>p{font-size:14px;line-height:1.9}.plan-questions h2{font-size:35px}.plan-questions .callout h3{font-size:23px}.plan-questions .text-link{font-size:12px}.usage-section{border-top:1px solid #dce3ee}.usage-list{margin-bottom:25px}.usage-list details{border-top:1px solid #dce3ee}.usage-list details:last-child{border-bottom:1px solid #dce3ee}.usage-list summary{display:flex;justify-content:space-between;list-style:none;padding:22px 0;font-size:15px;font-weight:700}.usage-list summary::-webkit-details-marker{display:none}.usage-list summary span{font-weight:400;color:#245be8;font-size:20px}.usage-list details[open] summary span{transform:rotate(45deg)}.usage-content{padding-bottom:25px}.rates-scroll{overflow:auto}.usage-content table{border-collapse:collapse;min-width:500px;width:100%;font-size:13px}.usage-content th,.usage-content td{padding:15px 18px;text-align:left;border-bottom:1px solid #dce3ee}.usage-content thead th{background:#f6f8fc;font-size:11px}.usage-content tbody th{font-weight:600}.usage-content p{font-size:12px;margin:17px 0 0}
@media(max-width:1000px){.plan-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.plan:nth-child(odd){border-left:0}.plan:nth-child(n+3){border-top:1px solid #dce3ee}.plan-questions{gap:45px}}
@media(max-width:760px){.pricing-introduction,.plan-questions{grid-template-columns:1fr;gap:0}.pricing-introduction>div{padding:28px}.plan-questions{gap:30px}.plan-questions h2{font-size:29px}.plan-grid{grid-template-columns:1fr}.plan+.plan{border-left:0;border-top:1px solid #dce3ee}.plan{padding:28px}.plan>p{min-height:0}.plan-price{font-size:40px;margin-top:5px}.pricing-content{padding-bottom:40px}.pricing-note{text-align:left}.usage-section .section-intro{gap:22px}}
</style>
