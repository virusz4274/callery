e:12px;width:21%;font-weight:700}.pattern-table td:nth-child(2){width:48%}.pattern-table td{color:#52637a}.pattern-table code{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:10px;color:#152541;white-space:nowrap}.pattern-table small{display:block;font-size:10px;line-height:1.9;color:#52637a;margin-top:8px;max-width:52ch}.pattern-note{margin:22px 0 0;max-width:90ch;font-size:11px}
@media(max-width:950px){.access-list{gap:32px}.access-list article>div{align-items:flex-start;flex-direction:column;gap:11px}.compatibility-checks{gap:30px}}
@media(max-width:760px){.compatibility-checks{grid-template-columns:1fr;gap:25px;padding-bottom:45px}.compatibility-checks article{position:relative;padding-left:44px}.compatibility-checks article>span{position:absolute;left:0;top:22px}.compatibility-checks h2{font-size:21px;margin-bottom:10px}.access-list{grid-template-columns:1fr;gap:27px}.access-list article>div{flex-direction:row;align-items:center}.access-list h3{font-size:19px}.access-list .pill{font-size:8px}.format-list{gap:9px}.format-list span{padding:10px 13px;font-size:13px}.pattern-table th,.pattern-table td{padding:17px}.closing .button{font-size:12px}}
</style>
