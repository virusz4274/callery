---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { siteUrl } from '../../lib/site';
const entries = await getCollection('guides', ({ data }) => !data.draft && data.category === 'import');
const guides = entries.filter(guide => guide.data.archiveWorkflow !== 'unsupported').sort((a, b) => a.data.manufacturer.localeCompare(b.data.manufacturer) || a.data.title.localeCompare(b.data.title));
const limitations = entries.filter(guide => guide.data.archiveWorkflow === 'unsupported');
const manufacturers = [...new Set(guides.map(guide => guide.data.manufacturer))];
const anchor = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const accessLabels = { files: 'Original files accessible', share: 'Unsupported sharing workflow', varies: 'OEM setup required', unverified: 'Not established for this build', unavailable: 'Unsupported folder workflow' };
const schema = { '@type': 'CollectionPage', name: 'Callery recording import guides', url: siteUrl('/guides'), description: 'Find accessible original recording folders, copy files in bulk without renaming them, and check caller and date recognition in Callery.' };
---
<SiteLayout title="Copy and import original phone call recordings" description="Copy Samsung and supported Android recording folders in bulk. Preserve filenames for Callery’s caller and date recognition. Understand why Google Phone sharing is unsupported." schema={schema}>
  <section class="container page-heading"><h1>Copy the folder.<br />Keep the original names.</h1><p>Start with recordings visible in your phone’s file manager. Copy the originals together, keep a backup, and check the caller and date in a small import. Sharing calls one at a time from a dialer is not a supported archive workflow.</p></section>
  <nav class="container guide-journey" aria-label="Guide sections"><a href="/call-recording"><span>Start recording</span>Check a supported OEM dialer and its storage</a><a href="/guides" aria-current="page"><span>Bring your recordings</span>Copy original files, back up, and import</a></nav>
  <div class="container guides-layout"><aside class="guide-sidebar"><nav aria-label="Guide manufacturers"><span>Browse folder-copy guides</span>{manufacturers.map(name => <a href={`#${anchor(name)}`}>{name}</a>)}<a href="#unsupported-workflows">Unsupported workflows</a></nav><a class="compatibility-link" href="/phone-compatibility">Not sure what works?<br /><span>Check phone compatibility</span></a></aside><div class="guide-groups">{manufacturers.map(manufacturer => <section id={anchor(manufacturer)} class="guide-group"><h2>{manufacturer}</h2><div class="guide-list">{guides.filter(guide => guide.data.manufacturer === manufacturer).map(guide => <article><div class="guide-tags"><span>{guide.data.task}</span><span>{accessLabels[guide.data.access]}</span></div><h3><a href={`/guides/${guide.id}`}>{guide.data.title}</a></h3><p>{guide.data.description}</p><a class="text-link" href={`/guides/${guide.id}`}>Read the guide</a></article>)}</div></section>)}
    <section id="unsupported-workflows" class="guide-group"><h2>Unsupported workflows</h2><p>Being able to play or share a call in the dialer does not mean its original files can be copied into Callery. These are limitations of the current setup; a compatible OEM dialer may make future recordings accessible on a phone that currently uses Google Phone.</p><div class="guide-list">{limitations.map(guide => <article><div class="guide-tags"><span>Compatibility limitation</span></div><h3><a href={`/guides/${guide.id}`}>{guide.data.title}</a></h3><p>{guide.data.description}</p><a class="text-link" href={`/guides/${guide.id}`}>Understand the limitation</a></article>)}</div></section>
    <div class="future-guides"><h2>Need to enable recording first?</h2><p>Check whether your exact firmware supports an OEM dialer that records into accessible storage. A dialer replacement is conditional, and a small test must confirm both file access and usable filenames.</p><a class="text-link" href="/call-recording">Find call recording setup instructions</a></div></div></div>
</SiteLayout>
<style>
.guide-journey{display:grid;grid-template-columns:1fr 1fr;gap:25px;margin-bottom:55px;border-block:1px solid #dce3ee;padding-block:20px}.guide-journey a{padding:8px 0;color:#52637a;font-size:13px;text-decoration:none}.guide-journey a span{display:block;color:#152541;font-size:16px;font-weight:700;margin-bottom:5px}.guide-journey a[aria-current] span,.guide-journey a:hover span{color:#245be8}.guide-journey a[aria-current]{border-left:3px solid #245be8;padding-left:20px}
.guides-layout{display:grid;grid-template-columns:220px 1fr;gap:80px;padding-bottom:100px}.guide-sidebar{padding-top:7px}.guide-sidebar nav{display:flex;flex-direction:column;align-items:flex-start;gap:15px}.guide-sidebar nav>span{font-size:11px;color:#52637a;margin-bottom:5px}.guide-sidebar nav a{font-size:14px;font-weight:650;text-decoration:none}.guide-sidebar nav a:hover{color:#245be8}.compatibility-link{display:block;margin-top:40px;border-top:1px solid #dce3ee;padding-top:23px;font-size:11px;line-height:1.9;color:#52637a;text-decoration:none}.compatibility-link span{color:#245be8;font-weight:700}.guide-group{scroll-margin-top:110px;margin-bottom:45px}.guide-group h2{font-size:25px;margin-bottom:20px}.guide-list article{border-top:1px solid #dce3ee;padding:25px 0 31px}.guide-tags{display:flex;flex-wrap:wrap;gap:10px 18px;margin-bottom:13px;color:#52637a;font-size:10px}.guide-tags>span:first-child{color:#245be8}.guide-list h3{font-size:23px;line-height:1.45;margin-bottom:12px;max-width:34ch}.guide-list h3 a{text-decoration:none}.guide-list h3 a:hover{color:#245be8}.guide-list p{font-size:14px;line-height:1.9;max-width:65ch;margin-bottom:16px}.guide-list .text-link{font-size:12px}.future-guides{padding:29px 32px;border-radius:12px;background:#f6f8fc;border:1px solid #dce3ee}.future-guides h2{font-size:23px}.future-guides p{font-size:13px;line-height:1.9;margin-bottom:15px}.future-guides p:last-child{margin-bottom:0}
@media(max-width:900px){.guides-layout{grid-template-columns:170px 1fr;gap:40px}}
@media(max-width:760px){.guides-layout{grid-template-columns:1fr;gap:35px;padding-bottom:65px}.guide-sidebar nav{flex-direction:row;flex-wrap:wrap;gap:12px 24px}.guide-sidebar nav>span{width:100%;margin:0}.guide-sidebar nav a{font-size:13px}.compatibility-link{margin-top:20px;padding-top:15px}.compatibility-link br{display:none}.compatibility-link span{margin-left:5px}.guide-group h2{font-size:23px}.guide-list h3{font-size:21px}.future-guides{padding:25px}}
@media(max-width:600px){.guide-journey{grid-template-columns:1fr;gap:12px;margin-bottom:35px}.guide-journey a{font-size:12px}.guide-journey a span{font-size:15px}.guide-journey a[aria-current]{padding-left:15px}}
</style>
