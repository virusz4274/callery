---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import LaunchStatus from '../../components/LaunchStatus.astro';
import GuideAssistant from '../../components/GuideAssistant.astro';
import { appUrl, siteConfig, siteUrl } from '../../lib/site';
export async function getStaticPaths() {
  const entries = await getCollection('guides', ({ data }) => !data.draft);
  return entries.map(guide => ({ params: { slug: guide.id }, props: { guide } }));
}
interface Props { guide: CollectionEntry<'guides'> }
const { guide } = Astro.props;
const { Content } = await render(guide);
const data = guide.data;
const guideIndex = data.archiveWorkflow === 'unsupported' ? '/guides#unsupported-workflows' : data.category === 'setup' ? '/call-recording' : '/guides';
const guideSection = data.archiveWorkflow === 'unsupported' ? 'Unsupported workflows' : data.category === 'setup' ? 'Call recording setup' : 'Import guides';
const accessLabels = { files: 'Original files accessible in a file manager', share: 'Per-recording sharing only', varies: 'Must confirm original files in a file manager', unverified: 'Not yet verified', unavailable: 'No supported original-file folder workflow' };
const workflowLabels = { 'folder-copy': 'Copy the accessible original recording files', conditional: 'OEM setup and file checks may be required', unsupported: 'This recording setup does not fit the bulk archive workflow' };
const reviewed = data.verifiedAt?.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const schema = [
  { '@type': 'Article', headline: data.title, description: data.description, datePublished: data.publishedAt.toISOString(), ...(data.updatedAt ? { dateModified: data.updatedAt.toISOString() } : {}), author: { '@type': 'Organization', name: 'Callery', url: siteUrl('/') }, publisher: { '@id': siteUrl('/#organization') }, mainEntityOfPage: siteUrl(`/guides/${guide.id}`) },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: guideSection, item: siteUrl(guideIndex) }, { '@type': 'ListItem', position: 2, name: data.title, item: siteUrl(`/guides/${guide.id}`) }] },
];
---
<SiteLayout title={data.title} description={data.description} type="article" schema={schema} guideCategory={data.category}>
  <article class="container reading-page guide-article">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Callery</a><span aria-hidden="true">/</span><a href={guideIndex}>{guideSection}</a><span aria-hidden="true">/</span><span>{data.manufacturer}</span></nav>
    <header class="article-heading"><span class="guide-task">{data.manufacturer} · {data.task}</span><h1>{data.title}</h1><p>{data.description}</p>{reviewed && <p class="reviewed">Sources reviewed <time datetime={data.verifiedAt?.toISOString()}>{reviewed}</time>. {data.verification === 'limited' ? 'Documentation-based guidance; device behavior may vary.' : 'See the scope and sources below.'}</p>}</header>
    <GuideAssistant title={data.title} manufacturer={data.manufacturer} guidePath={`/guides/${guide.id}`} archiveWorkflow={data.archiveWorkflow} />
    <aside class="workflow-requirement" data-archive-workflow={data.archiveWorkflow} aria-label="Callery compatibility"><h2>{workflowLabels[data.archiveWorkflow]}</h2><p>{data.archiveWorkflow === 'unsupported' ? 'A recording that can only be shared individually from the dialer does not meet Callery’s archive requirements. Your device may have an OEM dialer setup option for future recordings; check the model and firmware guide. Callery cannot retrieve private dialer files or recover caller details missing from a filename.' : 'Use original recordings visible in your phone’s file manager. Copy them in bulk without renaming them, then check caller and date recognition with a small import. A recording button alone does not establish compatibility.'}</p></aside>
    <details class="guide-scope"><summary>Check that this guide applies to your phone<span aria-hidden="true">+</span></summary><dl><div><dt>Devices</dt><dd>{data.devices}</dd></div><div><dt>Region</dt><dd>{data.region}</dd></div><div><dt>Dialer</dt><dd>{data.dialer}</dd></div><div><dt>Software</dt><dd>{data.osVersion}</dd></div><div><dt>Recording access</dt><dd>{accessLabels[data.access]}</dd></div><div><dt>Callery audio formats</dt><dd>{data.formats.join(', ')}. File access and filename requirements also apply.</dd></div><div><dt>Filename recognition</dt><dd>{data.metadataRecognition}</dd></div></dl></details>
    <div class="prose"><Content /></div>
    <section class="guide-sources" aria-labelledby="sources-title"><h2 id="sources-title">Sources and further reading</h2><ul>{data.sources.map(source => <li><a href={source.url}>{source.title}</a></li>)}</ul></section>
    {data.archiveWorkflow === 'unsupported' ? <aside class="guide-next"><div><h2>Check an OEM recording setup</h2><p>Find a compatible dialer setup that saves original files to accessible storage.</p></div><a class="button" href="/phone-compatibility">Check compatibility</a></aside> : data.category === 'setup' ? <aside class="guide-next"><div><h2>Can you copy the originals?</h2><p>Confirm file-manager access and unchanged filenames, then check caller and date recognition in a small import.</p></div><a class="button" href="/guides">Find a folder-copy guide</a></aside> : <aside class="guide-next"><div><h2>Original files ready?</h2><p>{siteConfig.comingSoon ? 'Managed hosting is launching soon. Self-host Callery to try a small import and review the caller and call date.' : 'Try a few unchanged files and review the caller and call date before importing your archive.'}</p></div>{siteConfig.comingSoon ? <div class="guide-launch-actions"><LaunchStatus small /><a class="text-link" href="/self-host">Explore self-hosting</a></div> : <a class="button" href={appUrl('/signup')}>Get started with Callery</a>}</aside>}
    <a class="text-link back-guides" href={guideIndex}>{data.archiveWorkflow === 'unsupported' ? 'Browse compatibility limitations' : data.category === 'setup' ? 'Browse call recording setup guides' : 'Browse all import guides'}</a>
  </article>
</SiteLayout>
<style>
.workflow-requirement{border-left:3px solid #245be8;background:#eaf0ff;padding:22px 24px;margin-bottom:25px;border-radius:0 8px 8px 0}.workflow-requirement h2{font-size:20px;line-height:1.5;margin-bottom:10px}.workflow-requirement p{font-size:13px;line-height:1.9;margin:0}.workflow-requirement[data-archive-workflow="unsupported"]{background:#fff5e9;border-color:#95601a}
.guide-launch-actions{display:flex;align-items:flex-start;flex-direction:column;gap:10px;flex-shrink:0}.guide-launch-actions .text-link{font-size:12px}
.article-heading h1{font-size:clamp(36px,4.5vw,55px);max-width:23ch;line-height:1.15;margin:17px 0 23px}.guide-task{font-size:11px;font-weight:650;color:#245be8}.article-heading>p{font-size:18px;line-height:1.85;max-width:65ch;margin-bottom:20px}.article-heading .reviewed{font-size:11px;color:#52637a;line-height:1.8;margin-bottom:32px}.guide-scope{background:#f6f8fc;border:1px solid #dce3ee;border-radius:10px;margin:0 0 35px}.guide-scope summary{padding:19px 23px;display:flex;justify-content:space-between;align-items:center;gap:15px;list-style:none;font-size:12px;font-weight:700}.guide-scope summary::-webkit-details-marker{display:none}.guide-scope summary>span{font-size:20px;font-weight:400;color:#245be8}.guide-scope[open] summary>span{transform:rotate(45deg)}.guide-scope dl{padding:0 23px 12px;margin:0}.guide-scope dl>div{display:grid;grid-template-columns:140px 1fr;gap:16px;padding:13px 0;border-top:1px solid #dce3ee;font-size:11px;line-height:1.8}.guide-scope dt{font-weight:650;color:#152541}.guide-scope dd{margin:0;color:#52637a}.guide-sources{margin-top:45px;padding-top:30px;border-top:1px solid #dce3ee}.guide-sources h2{font-size:23px;margin-bottom:18px}.guide-sources ul{padding-left:19px;font-size:13px;line-height:1.9;color:#245be8}.guide-sources li{padding-left:3px;margin-block:8px}.guide-next{display:flex;align-items:center;justify-content:space-between;gap:25px;background:#eaf0ff;border-radius:12px;padding:29px;margin-top:40px}.guide-next h2{font-size:22px;margin-bottom:10px}.guide-next p{font-size:12px;margin:0;max-width:34ch}.guide-next .button{font-size:11px;min-height:45px;padding:12px 17px;flex-shrink:0}.back-guides{display:inline-block;margin-top:30px;font-size:12px}
@media(max-width:760px){.article-heading h1{font-size:36px;max-width:23ch}.article-heading>p{font-size:16px}.guide-scope summary{padding:17px}.guide-scope dl{padding-inline:17px}.guide-scope dl>div{grid-template-columns:1fr;gap:4px}.guide-next{align-items:flex-start;flex-direction:column;padding:24px}.guide-next p{max-width:none}}
</style>
