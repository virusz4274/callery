---
import SiteLayout from '../layouts/SiteLayout.astro';
import ArchiveDemo from '../components/ArchiveDemo.astro';
import ProductScreenshot from '../components/ProductScreenshot.astro';
import LaunchStatus from '../components/LaunchStatus.astro';
import { appUrl, siteConfig, siteUrl } from '../lib/site';
const description = 'Organize original call recordings by contact and date. Search transcribed conversations and return to the audio. Check compatible recording setups for Samsung and other phones.';
const faqs = [
  { question: 'Does Callery record my phone calls?', answer: 'Callery organizes existing recordings. Use a compatible dialer that saves original files in accessible storage, then copy those files into Callery without changing their names. Uploads are manual today.' },
  { question: 'Which phones and files work?', answer: 'You need original recordings visible in your phone’s file manager, so you can copy them in bulk with filenames intact. Samsung Phone commonly saves them in Internal storage → Recordings → Call. Other phones may work with their OEM dialer, sometimes after device-specific setup. Callery accepts MP3, WAV, M4A, MP4, and WebM; automatic caller and date recognition also requires a recognized filename.' },
  { question: 'What if my phone currently uses Google Phone?', answer: 'Google Phone’s individual Share workflow is unsupported for the bulk archive. Your phone may have an OEM dialer setup option; check the guide for your exact model and firmware. A dialer change does not migrate existing Google Phone recordings. Callery cannot retrieve private dialer files or reconstruct caller details missing from filenames.' },
  { question: 'Do I need to transcribe every call?', answer: 'No. You can organize and listen without transcription. Add transcripts when you want to search what was said. Search by discussion needs a configured AI search service and indexed transcripts; timestamped playback depends on the transcript’s timing.' },
  { question: 'Can I use Callery on my computer?', answer: 'Yes. Callery runs in a browser on Windows, Mac, Linux, or your phone. There is no native desktop installer to download.' },
  { question: 'Can I download my archive later?', answer: 'Yes. Export original audio, available transcripts, and metadata, with a browser viewer for the downloaded archive. Keep an independent backup of your original recordings.' },
  { question: 'Can I sign up for managed Callery?', answer: siteConfig.comingSoon ? 'Managed Callery is launching soon. You can watch the demo, check your phone’s compatibility, or self-host the open-source app today. We are not collecting waitlist emails yet.' : 'Managed Callery is open for signup. Review the current plans and processing options before choosing your account.' },
];
const schema = [
  { '@type': 'SoftwareApplication', name: 'Callery', url: siteUrl('/'), applicationCategory: 'UtilitiesApplication', operatingSystem: 'Web', description, featureList: ['Bulk uploads of original recordings', 'Caller and date organization from recognized filenames', 'Original audio playback', 'Optional transcripts and summaries', 'Search transcribed conversations', 'Recording archive export'] },
  { '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
];
---
<SiteLayout title="Call Recording Organizer & Search" description={description} schema={schema}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy"><h1><span>Organize your call recordings.</span> <span>Find what was said.</span></h1><p>Important details, promises, and agreements often happen over the phone. Keep your saved recordings organized by contact and date, then search transcribed conversations for the details you need—even years later.</p><div class="actions">{siteConfig.comingSoon ? <LaunchStatus /> : <a class="button" href={appUrl('/signup')}>Organize my recordings</a>}<a class="demo-link" href={siteConfig.demoUrl}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="m10 8 6 4-6 4V8Z" fill="currentColor"/></svg>Watch the demo</a></div><p class="hero-note">{siteConfig.comingSoon ? 'Managed hosting is launching soon.' : 'Use Callery in your browser—no server setup.'}<br /><a href="/self-host">Free to self-host today.</a></p></div>
      <ArchiveDemo />
    </div>
    <div class="container compatibility-strip"><span>Bring original recording files</span><strong>Samsung Phone</strong><strong>Compatible OEM dialers</strong><span class="strip-formats">MP3 <i></i> WAV <i></i> M4A <i></i> MP4 <i></i> WebM</span><a href="/phone-compatibility">Check your recording setup</a></div>
  </section>
  <section class="section container">
    <div class="section-intro"><h2>Years of calls,<br />easier to find.</h2><p>A delivery detail. A commitment you want to remember. A conversation from months ago. Keep the recordings useful after they leave your phone.</p></div>
    <div class="benefits"><article><h3>Browse familiar names and dates</h3><p>Move beyond lists of audio filenames. Recognized original names help place your calls under the right caller and call date.</p><a class="text-link" href="/phone-compatibility#filename-patterns">Check filename recognition</a></article><article><h3>Find the discussion you remember</h3><p>Turn recorded conversations into searchable text. Search for words or, with AI search configured, describe what you talked about.</p><a class="text-link" href="/search-call-recordings">See how recording search works</a></article><article><h3>Keep the original conversation close</h3><p>Read a transcript or summary, then listen to the original when the details matter. Timed transcripts can take you back to a passage.</p><a class="text-link" href="/docs/user-guide">Explore the recording workspace</a></article></div>
  </section>
  <section class="product-proof section-tight"><div class="container"><div class="section-intro"><h2>See your calls<br />in Callery.</h2><p>Actual app screens show the upload, browsing, and playback journey. The recordings and people in these examples are fictional.</p></div><div class="screenshot-grid"><ProductScreenshot kind="upload" /><ProductScreenshot kind="library" /><ProductScreenshot kind="transcript" /></div></div></section>
  <section id="how-it-works" class="section container">
    <div class="section-intro"><h2>From the recording folder<br />to the conversation.</h2><p>Start with originals you can access. Keep their names intact so Callery can recognize the caller and date.</p></div>
    <ol class="workflow"><li><span class="step-number">1</span><h3>Copy the original files</h3><p>Find the recording folder in your phone’s file manager. Copy files together without renaming them, and keep a separate backup.</p><a class="text-link" href="/guides">Find your phone’s guide</a></li><li><span class="step-number">2</span><h3>Upload and check names and dates</h3><p>Open your Callery instance in a browser and select or drop a few copied files. Check playback, caller matching, and the original call date before adding the rest.</p><span class="step-detail">Automatic metadata needs recognized filenames.</span></li><li><span class="step-number">3</span><h3>Search what was said</h3><p>Add transcripts to the calls you want to search. Open a matching conversation, read the transcript, and return to the audio.</p><a class="text-link" href="/search-call-recordings">Explore text and discussion search</a></li></ol>
    <p class="workflow-note">Callery organizes recordings you already have; it does not record calls or automatically sync a phone folder. Transcription is optional for browsing and listening. Google Phone’s individual Share action is not the supported bulk archive workflow; some phones can use an OEM dialer after setup.</p>
  </section>
  <section class="container section founder-story" aria-labelledby="founder-story-title"><h2 id="founder-story-title">Built from a real problem.</h2><div><p>I built Callery because important work details and commitments happened on calls and never made it into an email. I kept the recordings because I might need them later.</p><p>After changing phones and moving years of audio to my computer or Google Drive, finding one conversation meant digging through filenames. Callery began as a way to organize those recordings. Transcripts and search made it easier to return to what was said.</p><a class="text-link" href="/guides/backup-and-organize-android-call-recordings">Organize recordings after changing phones</a></div></section>
  <section class="section container split privacy-section"><div><h2>Personal calls deserve<br />a clear privacy story.</h2><p>Callery stores uploaded recordings in the instance you use. Transcription and AI features send audio or text to the processing services configured for that instance.</p><p>You can self-host with your own database, storage, and processing services, including compatible local AI services. Managed hosting is {siteConfig.comingSoon ? 'launching soon' : 'available'}.</p><a class="text-link" href="/self-host">Understand self-hosting and processing</a></div><div class="archive-export"><svg width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true"><path d="M7 10h9l3 4h10v16H7V10Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M18 3v18m-5-5 5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><h3>Your archive can come with you.</h3><p>Download an organized export, and keep independent backups of the original files.</p><ul><li><span>Original recording files</span><span>✓</span></li><li><span>Available transcripts and metadata</span><span>✓</span></li><li><span>A viewer for your browser</span><span>✓</span></li></ul></div></section>
  <section class="guides-section section-tight"><div class="container"><div class="section-intro"><h2>Check the dialer.<br />Find the original folder.</h2><p>Samsung and other phones can provide usable original files. Some need their OEM dialer enabled first. Match the guide to your actual model and software, then verify a small import.</p></div><div class="guide-teasers"><a href="/samsung-call-recording-organizer"><span class="guide-brand">Samsung Phone</span><h3>Copy your Recordings/Call folder</h3><p>Keep original files and filenames for an archive organized by contact and date.</p><span class="text-link">Samsung recording organizer</span></a><a href="/call-recording"><span class="guide-brand">Android OEM dialers</span><h3>Check an OEM recording setup</h3><p>Compare Xiaomi, OnePlus, OPPO, realme, and Vivo options for your model and firmware, then check the original files and filenames.</p><span class="text-link">Call recording setup guides</span></a><a href="/phone-compatibility"><span class="guide-brand">Your phone</span><h3>Check what works before you import</h3><p>See accessible-file workflows, OEM setup options, and current Google Phone limitations.</p><span class="text-link">Check phone compatibility</span></a></div></div></section>
  <section class="section container faq-section"><div><h2>A few things<br />before you begin.</h2><p>More questions?<br /><a class="text-link" href="/support">Find help and guides.</a></p></div><div class="faq-list">{faqs.map(faq => <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div></section>
  <section class="closing"><div class="container"><div><h2>Keep the calls.<br />Find the details.</h2><p>{siteConfig.comingSoon ? 'Managed Callery is launching soon. Explore the demo or run your own archive today.' : 'Use managed Callery in your browser, or run your own archive.'}</p></div><div class="closing-actions">{siteConfig.comingSoon ? <LaunchStatus /> : <a class="button" href={appUrl('/signup')}>Get started with Callery</a>}<a href="/self-host" class="text-link">Explore self-hosting</a></div></div></section>
</SiteLayout>
<style>
.hero{background:#fff}.hero-grid{display:grid;grid-template-columns:1fr 1.12fr;gap:62px;align-items:center;padding-top:76px;padding-bottom:70px}.hero-copy{padding-bottom:12px}.hero-copy h1{font-size:clamp(44px,4.6vw,62px);letter-spacing:-.06em;line-height:1.08;margin-bottom:26px}.hero-copy>p:not(.hero-note){font-size:16px;line-height:1.9;max-width:43ch;margin-bottom:30px}.demo-link{display:inline-flex;gap:8px;align-items:center;text-decoration:none;font-size:12px;font-weight:700;padding:12px 0;margin-left:7px}.demo-link svg{color:#245be8}.hero-note{font-size:11px;line-height:1.8;margin:19px 0 0;color:#52637a}.compatibility-strip{display:flex;flex-wrap:wrap;align-items:center;gap:26px;border-top:1px solid #dce3ee;border-bottom:1px solid #dce3ee;padding-block:24px}.compatibility-strip>span:first-child{font-size:11px;color:#52637a;max-width:13ch;line-height:1.7;margin-right:10px}.compatibility-strip strong{font-size:14px;letter-spacing:-.03em}.strip-formats{display:flex;align-items:center;gap:9px;color:#52637a;font-size:10px;margin-left:12px}.strip-formats i{height:3px;width:3px;background:#b6c4d9;border-radius:50%}.compatibility-strip>a{margin-left:auto;color:#245be8;font-size:11px;font-weight:700;text-underline-offset:4px}.workflow{padding:0;list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:50px;margin-bottom:0}.workflow li{border-top:1px solid #dce3ee;padding-top:22px}.step-number{display:inline-flex;align-items:center;justify-content:center;width:29px;height:29px;border:1px solid #c6d6f6;border-radius:50%;color:#245be8;font-size:12px;font-weight:700;margin-bottom:23px}.workflow h3{margin-bottom:14px}.workflow p{font-size:14px;line-height:1.9;margin-bottom:16px}.workflow a{font-size:12px}.step-detail{font-size:11px;color:#52637a}.privacy-section>div>p{font-size:15px;line-height:1.9;max-width:54ch}.privacy-section{gap:115px}.privacy-section h2{margin-bottom:25px}.privacy-section .text-link{display:inline-block;margin-top:10px;font-size:13px}.archive-export{background:#eaf0ff;border-radius:14px;padding:38px}.archive-export>svg{color:#245be8;margin-bottom:18px}.archive-export h3{font-size:23px;line-height:1.4;margin-bottom:13px}.archive-export p{font-size:13px;line-height:1.9;max-width:37ch}.archive-export ul{padding:0;list-style:none;margin:25px 0 0}.archive-export li{display:flex;justify-content:space-between;border-top:1px solid #ccd9f5;padding:14px 0;font-size:12px}.archive-export li>span:last-child{color:#245be8}.guides-section{border-block:1px solid #dce3ee;background:#fbfcff}.guide-teasers{display:grid;grid-template-columns:repeat(3,1fr);gap:42px}.guide-teasers>a{text-decoration:none;border-top:2px solid #ccd9f5;padding-top:20px;display:flex;flex-direction:column;align-items:flex-start}.guide-teasers>a:hover{border-color:#245be8}.guide-brand{font-size:11px;font-weight:700;color:#245be8;margin-bottom:17px}.guide-teasers h3{font-size:20px;line-height:1.45;margin-bottom:13px}.guide-teasers p{font-size:13px;line-height:1.85;margin-bottom:22px}.guide-teasers .text-link{font-size:11px;margin-top:auto}.faq-section{display:grid;grid-template-columns:1fr 1.3fr;gap:100px}.faq-section h2{margin-bottom:24px}.faq-section>div>p{font-size:14px;line-height:1.9}.faq-list details{border-bottom:1px solid #dce3ee;padding-block:20px}.faq-list details:first-child{padding-top:0}.faq-list summary{display:flex;justify-content:space-between;gap:20px;list-style:none;font-size:14px;font-weight:700;line-height:1.8}.faq-list summary::-webkit-details-marker{display:none}.faq-list summary span{color:#245be8;font-size:20px;line-height:1.2;font-weight:400}.faq-list details[open] summary span{transform:rotate(45deg)}.faq-list p{font-size:13px;line-height:1.9;margin:14px 25px 0 0}.closing-actions{display:flex;flex-direction:column;align-items:center;gap:14px;flex-shrink:0}.closing-actions .text-link{font-size:12px}
@media(max-width:1100px){.hero-grid{gap:35px;grid-template-columns:1fr 1.08fr}.hero-copy h1{font-size:48px}.hero-copy .actions{gap:8px}.demo-link{font-size:11px;margin-left:0}.hero-copy .button{padding:12px 17px;font-size:12px}.compatibility-strip{gap:19px}.strip-formats{margin-left:0}.workflow{gap:30px}.privacy-section{gap:55px}.faq-section{gap:55px}}
@media(max-width:760px){.hero-grid{grid-template-columns:1fr;gap:32px;padding-top:48px;padding-bottom:36px}.hero-copy h1{font-size:clamp(41px,7.5vw,60px);max-width:20ch;margin-bottom:22px}.hero-copy>p:not(.hero-note){font-size:15px;margin-bottom:25px;max-width:46ch}.hero-copy .button{font-size:13px;padding:13px 20px}.hero-copy .actions{gap:17px}.demo-link{font-size:12px}.hero-note{font-size:10px}.hero-grid>figure{max-width:560px;width:100%;justify-self:center}.compatibility-strip{gap:17px;padding-block:22px}.compatibility-strip>span:first-child{width:100%;max-width:none;margin:0}.compatibility-strip strong{font-size:13px}.strip-formats{font-size:9px;gap:7px;margin-left:auto}.compatibility-strip>a{width:100%;margin-left:0;font-size:11px}.workflow{grid-template-columns:1fr;gap:30px}.workflow li{position:relative;padding-left:47px;padding-top:22px}.step-number{position:absolute;top:21px;left:0;margin:0}.workflow h3{font-size:20px;margin-bottom:9px}.workflow p{margin-bottom:10px;max-width:57ch}.privacy-section{gap:32px}.archive-export{padding:28px}.guide-teasers{grid-template-columns:1fr;gap:30px}.guide-teasers h3{max-width:27ch}.guide-teasers p{max-width:56ch;margin-bottom:12px}.guide-brand{margin-bottom:12px}.faq-section{grid-template-columns:1fr;gap:30px}.faq-section>div:first-child{display:flex;justify-content:space-between;align-items:flex-end;gap:30px}.faq-section h2{margin:0}.faq-section>div>p{font-size:12px;margin:0}.faq-list summary{font-size:13px}.closing-actions{align-items:flex-start}.closing-actions .text-link{margin-left:0}}
@media(max-width:440px){.strip-formats{width:100%;margin:0}.hero-copy .actions{gap:12px}.hero-copy .button{font-size:12px;padding:12px 17px}.demo-link{font-size:11px}.faq-section>div:first-child{display:block}.faq-section h2{margin-bottom:20px}}
.hero-copy h1 span{display:block}.benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:48px}.benefits article{border-top:1px solid #dce3ee;padding-top:23px}.benefits h3{font-size:23px;line-height:1.4;margin-bottom:15px;max-width:22ch}.benefits p{font-size:14px;line-height:1.9}.benefits .text-link{font-size:12px}.product-proof{border-block:1px solid #dce3ee;background:#f6f8fc}.screenshot-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:27px}.workflow-note{font-size:12px;line-height:1.9;max-width:80ch;margin:30px 0 0}.founder-story{display:grid;grid-template-columns:1fr 1.2fr;gap:100px;border-bottom:1px solid #dce3ee}.founder-story h2{max-width:18ch}.founder-story p{font-size:16px;line-height:1.95;max-width:62ch}.founder-story p:last-child{margin-bottom:0}
@media(max-width:950px){.benefits{gap:28px}.screenshot-grid{gap:18px}.founder-story{gap:45px}}
@media(max-width:760px){.benefits,.screenshot-grid,.founder-story{grid-template-columns:1fr;gap:30px}.benefits h3{max-width:none;font-size:22px}.benefits p{max-width:60ch}.screenshot-grid{gap:32px}.founder-story h2{max-width:24ch;margin-bottom:0}.founder-story p{font-size:15px}.hero-copy h1 span+span{margin-top:5px}}
</style>
