---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteUrl } from '../lib/site';

const guides = (await getCollection('guides', ({ data }) => !data.draft && data.category === 'setup'))
  .sort((a, b) => a.data.manufacturer.localeCompare(b.data.manufacturer) || a.data.title.localeCompare(b.data.title));
const manufacturers = [...new Set(guides.map(guide => guide.data.manufacturer))];
const anchor = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const schema = {
  '@type': 'CollectionPage', name: 'Enable call recording on Android', url: siteUrl('/call-recording'),
  description: 'Check OEM dialer routes and accessible original recording folders on Xiaomi, OnePlus, OPPO, realme, and Vivo. Google Phone per-call sharing is not a supported Callery archive workflow.',
  mainEntity: { '@type': 'ItemList', itemListElement: guides.map((guide, index) => ({ '@type': 'ListItem', position: index + 1, name: guide.data.title, url: siteUrl(`/guides/${guide.id}`) })) },
};
---
<SiteLayout title="Android call recording: OEM dialers and accessible files" description="Check Xiaomi, OnePlus, OPPO, realme, and Vivo recording setups. Callery requires original files accessible in storage, with filenames preserved for caller and date recognition." schema={schema}>
  <section class="container page-heading"><h1>Choose a recording setup<br />that keeps files accessible.</h1><p>Callery needs original recordings you can copy together from your phone’s file manager. The same brand can need different methods by model, region, firmware build, and dialer version. Check the built-in OEM dialer first, then the official app-store option or a clearly scoped community activation report in the matching guide. If a route’s required app or setting is unavailable, stop that route and check whether another documented route applies. External APKs, root, and firmware changes are outside these guides. Read the steps yourself or use the copyable instructions in each guide with an <a href="/guides/set-up-call-recording-with-ai">AI assistant</a>. Google Phone’s individual Share action does not meet the archive requirements.</p></section>
  <nav class="container guide-journey" aria-label="Guide sections"><a href="/call-recording" aria-current="page"><span>Start recording</span>Check a supported OEM dialer and its storage</a><a href="/guides"><span>Bring your recordings</span>Copy original files, back up, and import</a></nav>
  <div class="container setup-layout">
    <aside class="setup-sidebar"><nav aria-label="Setup guide manufacturers"><span>Find your phone</span>{manufacturers.map(name => <a href={`#${anchor(name)}`}>{name}</a>)}</nav><a href="/phone-compatibility" class="compatibility-link">Have a recording already?<br /><span>Check its file compatibility</span></a></aside>
    <div class="setup-groups">{manufacturers.map(manufacturer => <section id={anchor(manufacturer)} class="setup-group"><h2>{manufacturer}</h2><div class="setup-list">{guides.filter(guide => guide.data.manufacturer === manufacturer).map(guide => <article><p class="setup-task">{guide.data.task}</p><h3><a href={`/guides/${guide.id}`}>{guide.data.title}</a></h3><p>{guide.data.description}</p><a class="text-link" href={`/guides/${guide.id}`}>Read the setup guide</a></article>)}</div></section>)}
      <section class="recording-check"><h2>Test the whole path.</h2><ol><li><strong>Check your exact dialer and firmware.</strong><span>Use the manufacturer route where offered, or review a clearly labelled community procedure for the reported model and build. An app download or ADB command alone does not establish working call recording.</span></li><li><strong>Record and find the originals.</strong><span>Verify incoming and outgoing calls, then record a short agreed test and check both voices. Open your file manager and locate the actual recording folder. If you can only play or share inside the dialer, stop: this setup is unsupported for Callery’s archive workflow.</span></li><li><strong>Copy without renaming, then verify.</strong><span>Copy a few original files together. Check that their format is accepted and Callery reads the correct caller and call date. Preserve a separate backup before importing the rest.</span></li></ol><a class="text-link" href="/guides">Continue with folder copying and import</a></section>
    </div>
  </div>
</SiteLayout>
<style>
.guide-journey{display:grid;grid-template-columns:1fr 1fr;gap:25px;margin-bottom:55px;border-block:1px solid #dce3ee;padding-block:20px}.guide-journey a{padding:8px 0;color:#52637a;font-size:13px;text-decoration:none}.guide-journey a span{display:block;color:#152541;font-size:16px;font-weight:700;margin-bottom:5px}.guide-journey a[aria-current] span,.guide-journey a:hover span{color:#245be8}.guide-journey a[aria-current]{border-left:3px solid #245be8;padding-left:20px}.setup-layout{display:grid;grid-template-columns:220px 1fr;gap:80px;padding-bottom:100px}.setup-sidebar{padding-top:7px}.setup-sidebar nav{display:flex;flex-direction:column;align-items:flex-start;gap:15px}.setup-sidebar nav>span{font-size:11px;color:#52637a;margin-bottom:5px}.setup-sidebar nav a{font-size:14px;font-weight:650;text-decoration:none}.setup-sidebar nav a:hover{color:#245be8}.compatibility-link{display:block;margin-top:40px;border-top:1px solid #dce3ee;padding-top:23px;font-size:11px;line-height:1.9;color:#52637a;text-decoration:none}.compatibility-link span{color:#245be8;font-weight:700}.setup-group{scroll-margin-top:110px;margin-bottom:45px}.setup-group h2{font-size:25px;margin-bottom:20px}.setup-list article{border-top:1px solid #dce3ee;padding:25px 0 31px}.setup-task{font-size:11px;color:#245be8;margin-bottom:13px}.setup-list h3{font-size:23px;line-height:1.45;margin-bottom:12px;max-width:36ch}.setup-list h3 a{text-decoration:none}.setup-list h3 a:hover{color:#245be8}.setup-list article>p:not(.setup-task){font-size:14px;line-height:1.9;max-width:65ch;margin-bottom:16px}.setup-list .text-link{font-size:12px}.recording-check{border-top:1px solid #dce3ee;padding-top:30px;margin-top:15px}.recording-check h2{font-size:27px;margin-bottom:25px}.recording-check ol{list-style:none;counter-reset:recording-check;padding:0;margin-bottom:25px}.recording-check li{counter-increment:recording-check;position:relative;padding-left:42px;margin-bottom:23px}.recording-check li:before{content:counter(recording-check);position:absolute;left:0;top:0;width:27px;height:27px;display:flex;align-items:center;justify-content:center;border:1px solid #c6d6f6;border-radius:50%;color:#245be8;font-size:11px;font-weight:700}.recording-check strong{display:block;font-size:15px;margin-bottom:7px}.recording-check li span{display:block;font-size:13px;line-height:1.85;color:#52637a;max-width:65ch}.recording-check>.text-link{font-size:13px}
@media(max-width:900px){.setup-layout{grid-template-columns:170px 1fr;gap:40px}}
@media(max-width:760px){.setup-layout{grid-template-columns:1fr;gap:35px;padding-bottom:65px}.setup-sidebar nav{flex-direction:row;flex-wrap:wrap;gap:12px 24px}.setup-sidebar nav>span{width:100%;margin:0}.setup-sidebar nav a{font-size:13px}.compatibility-link{margin-top:20px;padding-top:15px}.compatibility-link br{display:none}.compatibility-link span{margin-left:5px}.setup-group h2{font-size:23px}.setup-list h3{font-size:21px}.recording-check h2{font-size:25px}}
@media(max-width:600px){.guide-journey{grid-template-columns:1fr;gap:12px;margin-bottom:35px}.guide-journey a{font-size:12px}.guide-journey a span{font-size:15px}.guide-journey a[aria-current]{padding-left:15px}}
</style>
