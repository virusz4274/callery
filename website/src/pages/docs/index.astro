---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { documentationGroups, documentationPages, type DocumentationGroup } from '../../lib/documentation';
import { siteUrl } from '../../lib/site';

const groupDescriptions: Record<DocumentationGroup, string> = {
  'Using Callery': 'Bring in your recordings, find the conversation you need, and manage processing.',
  Developers: 'Connect your own tools to the archive with the recording API and MCP.',
  'Self-hosting': 'Run your own instance and prepare for day-to-day operation and recovery.',
};
const groupAnchor = (group: DocumentationGroup) => group.toLowerCase().replaceAll(' ', '-');
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': siteUrl('/docs#documentation'),
    name: 'Callery documentation',
    description: 'Guides for using Callery, connecting integrations, and running your own call recording archive.',
    url: siteUrl('/docs'),
    hasPart: documentationPages.map((page) => ({
      '@type': 'TechArticle',
      name: page.title,
      description: page.description,
      url: siteUrl(`/docs/${page.slug}`),
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Documentation', item: siteUrl('/docs') },
    ],
  },
];
---

<SiteLayout title="Documentation" description="Learn to use Callery, connect the recording API and AI assistants, or self-host your own call recording archive." schema={schema}>
  <header class="container page-heading documentation-heading">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Documentation</span></nav>
    <h1>Make the archive<br />work for you.</h1>
    <p>Practical documentation for using Callery, connecting your tools, and running your own instance.</p>
  </header>
  <div class="container documentation-directory">
    <aside class="documentation-index">
      <nav aria-label="Documentation sections">
        {documentationGroups.map((group) => <a href={`#${groupAnchor(group)}`}>{group}</a>)}
      </nav>
      <div class="phone-guides-link"><p>Copying original files from your phone?</p><a href="/guides">Find recording folder guides</a><a href="/call-recording">Check a supported recording setup</a></div>
    </aside>
    <div class="documentation-groups">
      {documentationGroups.map((group) => (
        <section class="documentation-group" id={groupAnchor(group)} aria-labelledby={`${groupAnchor(group)}-heading`}>
          <header><h2 id={`${groupAnchor(group)}-heading`}>{group}</h2><p>{groupDescriptions[group]}</p></header>
          <ul class="documentation-list">
            {documentationPages.filter((page) => page.group === group).map((page) => (
              <li><a href={`/docs/${page.slug}`}><h3>{page.title}</h3><p>{page.description}</p><span>Read documentation</span></a></li>
            ))}
          </ul>
        </section>
      ))}
      <aside class="documentation-support"><h2>Have a question about your archive?</h2><p>Find account support, report a reproducible issue, or check where your phone keeps its recordings.</p><a class="text-link" href="/support">Find support</a></aside>
    </div>
  </div>
</SiteLayout>

<style>
  .documentation-heading{padding-top:40px;padding-bottom:55px}.documentation-heading .breadcrumb{margin-bottom:35px}.documentation-heading h1{max-width:18ch}.documentation-directory{display:grid;grid-template-columns:220px minmax(0,1fr);gap:62px;padding-bottom:100px}.documentation-index{padding-top:5px}.documentation-index nav{display:flex;flex-direction:column;align-items:flex-start;gap:19px}.documentation-index nav a{font-size:14px;font-weight:750;text-decoration:none}.documentation-index nav a:hover{color:var(--blue)}.phone-guides-link{margin-top:38px;padding-top:24px;border-top:1px solid var(--line);font-size:12px;line-height:1.8}.phone-guides-link p{font-weight:700;color:var(--ink);margin-bottom:10px}.phone-guides-link a{display:block;color:var(--blue);margin-top:10px}.documentation-groups{max-width:850px;min-width:0}.documentation-group{scroll-margin-top:120px;margin-bottom:55px}.documentation-group>header{margin-bottom:24px}.documentation-group h2{font-size:30px;margin-bottom:11px}.documentation-group>header p{font-size:14px;max-width:64ch;margin-bottom:0}.documentation-list{list-style:none;margin:0;padding:0}.documentation-list li{border-top:1px solid var(--line)}.documentation-list li:last-child{border-bottom:1px solid var(--line)}.documentation-list a{display:block;text-decoration:none;padding:24px 0 26px}.documentation-list h3{font-size:22px;line-height:1.4;margin-bottom:9px;max-width:35ch}.documentation-list p{font-size:13px;line-height:1.85;max-width:68ch;margin-bottom:13px}.documentation-list span{font-size:11px;font-weight:750;color:var(--blue)}.documentation-list a:hover h3{color:var(--blue);text-decoration:underline;text-underline-offset:5px}.documentation-support{border-left:3px solid var(--blue);padding:3px 0 3px 26px}.documentation-support h2{font-size:24px;line-height:1.4;margin-bottom:12px;max-width:30ch}.documentation-support p{font-size:13px;max-width:65ch;margin-bottom:15px}.documentation-support a{font-size:12px}
  @media(max-width:1100px){.documentation-directory{grid-template-columns:190px minmax(0,1fr);gap:35px}}
  @media(max-width:800px){.documentation-heading{padding-top:28px;padding-bottom:34px}.documentation-heading .breadcrumb{margin-bottom:28px}.documentation-directory{grid-template-columns:1fr;gap:37px;padding-bottom:65px}.documentation-index{display:grid;grid-template-columns:1fr 1fr;gap:25px;border-block:1px solid var(--line);padding-block:22px}.documentation-index nav{gap:13px}.documentation-index nav a{font-size:13px}.phone-guides-link{margin:0;padding:0 0 0 22px;border-top:0;border-left:1px solid var(--line)}.phone-guides-link p{margin-bottom:8px}.phone-guides-link a{font-size:11px;margin-top:8px}.documentation-group{margin-bottom:40px;scroll-margin-top:95px}.documentation-group h2{font-size:27px}.documentation-list h3{font-size:20px}.documentation-support{padding-left:21px}.documentation-support h2{font-size:22px}}
  @media(max-width:420px){.documentation-index{grid-template-columns:1fr;gap:23px}.documentation-index nav{flex-direction:row;gap:12px 23px;flex-wrap:wrap}.phone-guides-link{border:0;padding:0}.phone-guides-link a{display:inline-block;margin-right:20px}}
</style>
