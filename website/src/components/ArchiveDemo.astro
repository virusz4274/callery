---
const bars = [14, 24, 39, 22, 17, 31, 49, 27, 18, 32, 52, 40, 23, 16, 26, 43, 30, 17, 34, 48, 29, 21, 15, 33, 43, 24, 17, 35, 47, 25, 15, 24, 39, 28, 18, 26];
---
<figure class="archive-demo" aria-label="Illustrative example: recording files organized into a contact timeline and transcript">
  <div class="file-stack" aria-hidden="true">
    <div class="folder-tab">Recordings / Call</div>
    <div class="file-row"><svg viewBox="0 0 24 24" fill="none"><path d="M7 3h7l4 4v14H7zM14 3v5h5M10 12v5m3-7v9m3-6v3" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg><span>Call Maya_261108_103000.m4a</span><span>8:24</span></div>
    <div class="file-row"><svg viewBox="0 0 24 24" fill="none"><path d="M7 3h7l4 4v14H7zM14 3v5h5M10 12v5m3-7v9m3-6v3" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg><span>Call Alex_261107_174500.m4a</span><span>12:06</span></div>
    <div class="file-row"><svg viewBox="0 0 24 24" fill="none"><path d="M7 3h7l4 4v14H7zM14 3v5h5M10 12v5m3-7v9m3-6v3" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg><span>Call Maya_261106_091500.m4a</span><span>6:18</span></div>
  </div>
  <div class="archive-window">
    <div class="window-bar"><span><img src="/brand/callery-logo.png" width="18" height="18" alt="" />My call archive</span><span class="window-dots"><i></i><i></i><i></i></span></div>
    <div class="search-field"><svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.7"/><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg><span>What time was the delivery?</span><kbd>↵</kbd></div>
    <div class="archive-body">
      <div class="contact-list"><p>By contact</p><div class="contact selected"><span class="avatar">M</span><span><strong>Maya</strong><small>2 recordings</small></span><span class="contact-dot"></span></div><div class="contact"><span class="avatar second">A</span><span><strong>Alex</strong><small>1 recording</small></span></div><div class="contact-list-line"></div><span class="contact-hint">Original audio,<br />all in one place.</span></div>
      <div class="recording-detail"><div class="detail-heading"><div><h3>The delivery details</h3><p>Maya <span>November 8, 2026</span></p></div><span class="duration">8:24</span></div><div class="summary"><span class="summary-icon">✧</span><p>Delivery is booked for <strong>Friday at 10 am</strong>. Leave the boxes by the front door.</p></div><div class="transcript-line"><span>02:14</span><p>“Friday at ten works. I’ll be there to let them in.”</p></div><div class="wave-player"><span class="play-icon" aria-hidden="true">▶</span><div class="waveform" aria-hidden="true">{bars.map((height, index) => <span style={`height:${height}px`} class:list={{ played: index < 12 }}></span>)}</div><span class="player-time">2:14 / 8:24</span></div></div>
    </div>
  </div>
  <figcaption>Illustrative archive with fictional calls and transcript.</figcaption>
</figure>
<style>
.archive-demo{position:relative;margin:0;padding-top:35px;min-width:0}.file-stack{width:81%;margin-left:auto;margin-right:17px;position:relative;padding:26px 16px 14px;border:1px solid #ccdaed;border-radius:0 12px 0 0;background:#eaf0ff;transform:rotate(3deg);transform-origin:bottom right}.folder-tab{position:absolute;top:-25px;left:-1px;border:1px solid #ccdaed;border-bottom:0;background:#eaf0ff;border-radius:10px 10px 0 0;padding:6px 14px;font-size:10px;font-weight:700;color:#52637a;line-height:1.5}.file-row{display:flex;align-items:center;gap:9px;padding:8px 4px;font-size:9px;color:#52637a;line-height:1.3}.file-row+ .file-row{border-top:1px solid #dce3ee}.file-row svg{width:18px;height:22px;flex-shrink:0;color:#245be8}.file-row>span:last-child{margin-left:auto;font-size:8px}.archive-window{position:relative;background:#fff;border:1px solid #d1dceb;border-radius:13px;overflow:hidden;margin-top:-8px;box-shadow:0 22px 48px -24px rgb(21 37 65 / .28)}.window-bar{display:flex;align-items:center;justify-content:space-between;padding:15px 17px;border-bottom:1px solid #e4eaf3;font-size:10px;font-weight:750}.window-bar>span{display:flex;align-items:center;gap:7px}.window-bar img{width:18px;height:18px;object-fit:contain}.window-dots{gap:4px!important}.window-dots i{width:5px;height:5px;border-radius:50%;background:#dce3ee}.search-field{margin:16px 18px 0;border:1px solid #ccdaed;display:flex;gap:9px;align-items:center;border-radius:7px;padding:11px 12px;font-size:11px;color:#52637a;background:#fbfcff}.search-field svg{flex-shrink:0;color:#245be8}.search-field kbd{margin-left:auto;font:inherit;color:#52637a}.archive-body{display:grid;grid-template-columns:138px 1fr;padding:22px 0 0}.contact-list{padding:0 11px;border-right:1px solid #e4eaf3}.contact-list>p{font-size:9px;padding-left:8px;margin-bottom:13px}.contact{padding:10px 8px;display:flex;gap:7px;align-items:center;margin-bottom:5px}.contact.selected{background:#eaf0ff;border-radius:6px}.avatar{display:grid;place-items:center;flex-shrink:0;width:25px;height:25px;border-radius:50%;background:#d5e1ff;color:#245be8;font-size:10px;font-weight:700}.avatar.second{background:#e8ecf2;color:#52637a}.contact strong{font-size:10px;display:block;line-height:1.4}.contact small{display:block;font-size:7px;color:#52637a;white-space:nowrap}.contact-dot{width:4px;height:4px;border-radius:50%;background:#245be8;margin-left:auto}.contact-list-line{width:30px;height:1px;background:#dce3ee;margin:27px 8px 13px}.contact-hint{font-size:8px;line-height:1.8;display:block;margin-left:8px;color:#52637a}.recording-detail{padding:0 20px 16px;min-width:0}.detail-heading{display:flex;align-items:flex-start;gap:10px}.detail-heading h3{font-size:14px;margin:0 0 5px;letter-spacing:-.025em}.detail-heading p{font-size:8px;margin:0}.detail-heading p span{margin-left:9px;color:#52637a}.duration{font-size:8px;margin-left:auto;padding-top:3px;color:#52637a}.summary{display:flex;align-items:flex-start;gap:8px;border-radius:7px;background:#f2f5fc;padding:13px 12px;margin-top:17px}.summary-icon{color:#245be8;font-size:20px;line-height:1.3}.summary p{font-size:11px;line-height:1.8;margin:0;color:#52637a}.summary strong{color:#152541;font-weight:750}.transcript-line{display:flex;align-items:baseline;gap:10px;margin:16px 0}.transcript-line>span{font-size:8px;color:#245be8}.transcript-line p{font-size:10px;line-height:1.8;margin:0;color:#52637a}.wave-player{border-top:1px solid #e4eaf3;display:flex;align-items:center;gap:10px;padding-top:13px}.play-icon{width:23px;height:23px;border-radius:50%;display:grid;place-items:center;background:#245be8;color:#fff;font-size:8px;padding-left:1px;flex-shrink:0}.waveform{height:36px;display:flex;align-items:center;gap:2px;flex:1;overflow:hidden}.waveform span{width:2px;max-height:29px;background:#cdd8eb;flex-shrink:0}.waveform span.played{background:#245be8}.player-time{font-size:7px;color:#52637a;white-space:nowrap}.archive-demo figcaption{font-size:9px;color:#52637a;text-align:right;margin:16px 5px 0}
@media(max-width:1100px) and (min-width:761px){.archive-body{grid-template-columns:108px 1fr}.contact-list{padding-inline:7px}.contact{padding-inline:5px;gap:5px}.recording-detail{padding-inline:14px}.detail-heading p span{display:block;margin:3px 0 0}.summary p{font-size:10px}.player-time{display:none}}
@media(max-width:480px){.archive-body{grid-template-columns:95px 1fr;padding-top:17px}.contact-list{padding-inline:5px}.contact{padding-inline:5px;gap:5px}.contact small{font-size:6px}.avatar{width:21px;height:21px;font-size:9px}.recording-detail{padding-inline:12px}.detail-heading h3{font-size:12px}.detail-heading p span{display:block;margin:3px 0 0}.summary{padding:10px 8px;gap:5px}.summary p{font-size:10px}.transcript-line p{font-size:9px}.player-time{display:none}.file-stack{width:88%;margin-right:12px}.file-row{font-size:8px}.archive-demo figcaption{font-size:8px}.contact-hint{font-size:7px}}
</style>
