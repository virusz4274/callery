{
  "name": "vosift",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 9000",
    "build": "next build --webpack",
    "postbuild": "node scripts/prepare-standalone.mjs && node scripts/verify-pwa.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:init": "tsx src/lib/db/init.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "test": "tsx --test --import ./src/test/env-test-setup.ts \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:dependencies": "node --test scripts/dependency-security.test.mjs",
    "test:release": "node --test scripts/release-tooling.test.mjs scripts/ci-billing-smoke.test.mjs scripts/stripe-app-sandbox.test.mjs",
    "audit:secrets": "node scripts/scan-secrets.mjs",
    "billing:migrate": "tsx scripts/migrate-billing.ts",
    "acceptance:selfhost": "node scripts/ci-acceptance.mjs --billing=false --checks",
    "acceptance:managed": "node scripts/ci-acceptance.mjs --billing=true --checks",
    "audit": "node scripts/audit-prod.mjs",
    "audit:prod": "node scripts/audit-prod.mjs --prod",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:dependencies && pnpm test:release && pnpm test:runtime && pnpm run audit",
    "test:runtime": "node --test scripts/runtime-lifecycle.test.mjs",
    "build:runtimes": "node scripts/verify-runtime-builds.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@better-auth/mongo-adapter": "^1.7.10",
    "@google/genai": "^2.30.0",
    "@googleapis/people": "^12.0.1",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@hookform/resolvers": "^5.9.1",
    "@internationalized/date": "^3.12.4",
    "@sentry/nextjs": "^11.8.0",
    "@serwist/next": "^9.5.13",
    "@smithy/fetch-http-handler": "5.8.0",
    "@soniox/speech-to-text-web": "^1.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vinext/cloudflare": "^1.1.1",
    "archiver": "^8.0.0",
    "better-auth": "^1.7.10",
    "busboy": "1.6.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.8",
    "google-auth-library": "^11.3.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.58.0",
    "mongodb": "^7.7.0",
    "motion": "^14.3.0",
    "music-metadata": "^12.2.1",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.2",
    "p-limit": "^7.3.3",
    "postcss": "^8.5.30",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-server-dom-webpack": "^19.3.1",
    "recharts": "^3.10.1",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "vinext": "^1.2.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.1",
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.64.1",
    "@types/archiver": "^8.0.0",
    "@types/busboy": "1.5.5",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "1.0.0-beta.18",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "punycode": "2.3.1",
    "serwist": "^9.5.13",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.3.4"
  }
}
