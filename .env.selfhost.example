# Copy to .env for Docker Compose. Full variable reference: .env.example.
# Set BETTER_AUTH_SECRET and a transcription backend; storage + database are
# bundled (MinIO + MongoDB) under the selfhost profile.
AUTH_PROVIDER=local
NEXT_PUBLIC_AUTH_PROVIDER=local
NEXT_PUBLIC_ENABLE_BILLING=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=
ADMIN_EMAILS=
EMAIL_PROVIDER=none

# Compose starts and initializes this database automatically.
# NOTE: semantic (vector) + full-text search need Atlas Search indexes — on
# this self-hosted MongoDB semantic search is unavailable and keyword search
# falls back to regex. For semantic search, set MONGODB_URI to an Atlas URI
# and create the two Search indexes from `pnpm run db:init` output.
MONGODB_URI=mongodb://mongo:27017/vosift

# Bundled MinIO (selfhost profile): the app uses R2_ENDPOINT, the browser uses
# S3_PUBLIC_ENDPOINT for playback. The bucket is auto-created on first start.
# Change the credentials for anything beyond local trials (min 8 chars each);
# changing them later requires resetting the minio-data volume.
# To use R2 / AWS / external MinIO instead, point these at that backend.
R2_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=vosift
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Choose soniox, elevenlabs, gemini, or openai_compat; see docs/setup-guide.md.
TRANSCRIPTION_PROVIDER=soniox
SONIOX_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_PROVIDER=gemini

# For your own Whisper and Ollama servers (operator-run, not bundled), set both
# providers to openai_compat and point these at them (include the /v1 path).
TRANSCRIPTION_COMPAT_BASE_URL=
TRANSCRIPTION_COMPAT_API_KEY=
TRANSCRIPTION_COMPAT_MODEL=whisper-1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_CHAT_MODEL=
OPENAI_COMPAT_EMBEDDING_MODEL=
